<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Colours of BOR's windows and building tabs under [LFS] UI Rethemed, one scheme per tier. Buildings name theirs with
       <li Class="BeyondOurReach.BorUIScheme"><scheme>...</scheme></li> in modExtensions; windows pick theirs in code.
       Ignored without UI Rethemed. Colours are hex; slots left out keep the player's own theme colour.

       Slots: well / card / panel / window / titleBar are surfaces (darkest to lightest); primary (selection, confirm
       buttons, title line, pattern), info, warn, danger and neutral are accents; text / textDim are text.
       patternTexture: a seamless white-on-transparent mask drawn as the background pattern, patternTileSize pixels per
       tile; pattern is the theme's own style used if the texture can't be (Honeycomb, Glow, Lines, Crosshatch, Grid,
       Dots, Stars, Plain). The masks in Textures/BOR/UI/Patterns are made from the tier's floor texture. -->

  <!-- Solar: gold, the sunforge's light orange body and the teal of its ring, over deep teal. Floor: sunsteel tile. -->
  <BeyondOurReach.BorUISchemeDef>
    <defName>BOR_UIScheme_Solar</defName>
    <well>0B171B</well>
    <card>12232A</card>
    <panel>2B4851</panel>
    <window>102027</window>
    <titleBar>0E1D22</titleBar>
    <primary>E3A93B</primary>
    <warn>E8955F</warn>
    <info>5AA6B3</info>
    <danger>C9542C</danger>
    <neutral>8FA6AB</neutral>
    <text>F4EEE4</text>
    <textDim>A7B8BC</textDim>
    <patternTexture>BOR/UI/Patterns/Sunsteel</patternTexture>
    <patternTileSize>192</patternTileSize>
    <pattern>Glow</pattern>
  </BeyondOurReach.BorUISchemeDef>

  <!-- Kwazaari: the periwinkle and silver of tier 2 machines, their orange-red trim and the yellow of the kwazaari tile,
       over deep navy. Floor: kwazaari tile, as line-art. -->
  <BeyondOurReach.BorUISchemeDef>
    <defName>BOR_UIScheme_Kwazaari</defName>
    <well>0D0F1E</well>
    <card>151A30</card>
    <panel>343B60</panel>
    <window>121629</window>
    <titleBar>0F1226</titleBar>
    <primary>7A88F2</primary>
    <info>A3B0DA</info>
    <warn>F0B848</warn>
    <danger>D8572A</danger>
    <neutral>9AA0BE</neutral>
    <text>EEF0FA</text>
    <textDim>A6ACC8</textDim>
    <patternTexture>BOR/UI/Patterns/Kwazaari</patternTexture>
    <patternTileSize>512</patternTileSize>
    <pattern>Lines</pattern>
  </BeyondOurReach.BorUISchemeDef>

  <!-- Tenebral and Umbral share one look: crimson over near-black, the slate of their casings as the info colour.
       Floor: tenebrite tile, its red hexagons. -->
  <BeyondOurReach.BorUISchemeDef>
    <defName>BOR_UIScheme_Tenebral</defName>
    <well>0C0909</well>
    <card>151012</card>
    <panel>3A2A2E</panel>
    <window>120D0F</window>
    <titleBar>0F0A0B</titleBar>
    <primary>B8202A</primary>
    <info>7D8A99</info>
    <warn>D89A3A</warn>
    <danger>E8452E</danger>
    <neutral>8C8084</neutral>
    <text>F0E6E6</text>
    <textDim>AE9EA2</textDim>
    <patternTexture>BOR/UI/Patterns/Tenebrite</patternTexture>
    <patternTileSize>512</patternTileSize>
    <pattern>Honeycomb</pattern>
  </BeyondOurReach.BorUISchemeDef>

  <!-- Orientis: the sage and glowing emerald of their buildings over deep green, gold (their trim and suns) as the main
       colour. No floor: the pattern is faint rising flames, 24 looping frames (Textures/BOR/UI/Patterns/Flame, made by
       Scripts/ui_pattern_flames.py). Blessing and Manifest windows, holy forge and offerings bench. -->
  <BeyondOurReach.BorUISchemeDef>
    <defName>BOR_UIScheme_Orientis</defName>
    <well>0C1410</well>
    <card>13201A</card>
    <panel>31483B</panel>
    <window>101A15</window>
    <titleBar>0E1812</titleBar>
    <primary>F0C050</primary>
    <info>3DD27A</info>
    <warn>F2DC78</warn>
    <danger>D9604A</danger>
    <neutral>9DB3A6</neutral>
    <text>F4F0E0</text>
    <textDim>AFC0B4</textDim>
    <patternTexture>BOR/UI/Patterns/Flame/Flame</patternTexture>
    <patternFrames>24</patternFrames>
    <patternFps>10</patternFps>
    <patternTileSize>256</patternTileSize>
    <pattern>Glow</pattern>
  </BeyondOurReach.BorUISchemeDef>

</Defs>
