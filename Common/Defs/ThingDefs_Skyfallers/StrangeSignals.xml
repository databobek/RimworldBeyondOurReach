<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Landed trader shuttle; reuses the core shuttle texture -->
  <ThingDef ParentName="BuildingBase">
    <defName>BOR_SignalShuttle</defName>
    <label>kwazaari shuttle</label>
    <description>A sleek shuttle answering the strange signals. Its pilot is waiting to talk.</description>
    <thingClass>BeyondOurReach.Building_SignalShuttle</thingClass>
    <tickerType>Normal</tickerType>
    <size>(5,3)</size>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <useHitPoints>false</useHitPoints>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <graphicData>
      <texPath>Things/Building/Misc/Shuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,3)</drawSize>
      <color>(162,164,149)</color>
    </graphicData>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>BOR_SignalShuttleIncoming</defName>
    <label>kwazaari shuttle (incoming)</label>
    <skyfaller>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <angleCurve>
        <points>
          <li>(0,-60)</li>
          <li>(1,-90)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
    <!-- A guest: anti-air (CE, VFE Security) leaves it alone. -->
    <modExtensions>
      <li Class="BeyondOurReach.DefModExtension_NoAntiAir" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>BOR_SignalShuttleLeaving</defName>
    <label>kwazaari shuttle (leaving)</label>
    <skyfaller>
      <reversed>true</reversed>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <angleCurve>
        <points>
          <li>(0,90)</li>
          <li>(1,70)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.05,2.5)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.1)</li>
          <li>(0.4,0.6)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <!-- Badzaari raider shuttle (signal raids on the sigma-class sagittary autoscope). Locked during the raid,
       then the colony's to deconstruct; one per raid drops the reward. -->
  <ThingDef Name="BOR_RaidShuttleBase" ParentName="BuildingBase">
    <defName>BOR_RaidShuttle</defName>
    <label>badzaari shuttle</label>
    <description>A battered raider shuttle. Once its crew is dealt with, it can be stripped for parts.</description>
    <thingClass>BeyondOurReach.Building_RaidShuttle</thingClass>
    <tickerType>Normal</tickerType>
    <size>(5,3)</size>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Building/Misc/Shuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,3)</drawSize>
      <color>(120,72,64)</color>
    </graphicData>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
    </statBases>
    <costList>
      <Plasteel>100</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <ThingDef Name="BOR_RaidShuttleIncomingBase" ParentName="ShuttleSkyfallerBase">
    <defName>BOR_RaidShuttleIncoming</defName>
    <label>badzaari shuttle (incoming)</label>
    <graphicData>
      <color>(120,72,64)</color>
    </graphicData>
    <skyfaller>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <angleCurve>
        <points>
          <li>(0,-60)</li>
          <li>(1,-90)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <!-- Tenebral arrivals (Peculiar broadcasts). Deep-red shuttle when the Badzaari are missing (drops the motor
       on deconstruction), deep-red drop pod otherwise. -->
  <ThingDef ParentName="BOR_RaidShuttleBase">
    <defName>BOR_TenebralShuttle</defName>
    <label>tenebral shuttle</label>
    <description>A deep-red shuttle that brought a lone tenebral. Once he is dealt with, it can be stripped for parts.</description>
    <graphicData>
      <color>(110,12,18)</color>
    </graphicData>
    <modExtensions>
      <li Class="BeyondOurReach.DefModExtension_DarkThing" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BOR_RaidShuttleIncomingBase">
    <defName>BOR_TenebralShuttleIncoming</defName>
    <label>tenebral shuttle (incoming)</label>
    <graphicData>
      <color>(110,12,18)</color>
    </graphicData>
    <modExtensions>
      <li Class="BeyondOurReach.DefModExtension_DarkThing" />
      <li Class="BeyondOurReach.DefModExtension_NoAntiAir" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="DropPodIncoming">
    <defName>BOR_TenebralPodIncoming</defName>
    <label>tenebral drop pod (incoming)</label>
    <graphicData>
      <color>(130,14,22)</color>
    </graphicData>
    <modExtensions>
      <li Class="BeyondOurReach.DefModExtension_DarkThing" />
      <li Class="BeyondOurReach.DefModExtension_NoAntiAir" />
    </modExtensions>
  </ThingDef>

  <!-- Junk pod: drops a slag chunk and splatters trash and rubble -->
  <ThingDef ParentName="SkyfallerBase">
    <defName>BOR_FilthPodIncoming</defName>
    <label>junk pod (incoming)</label>
    <thingClass>BeyondOurReach.Skyfaller_FilthPod</thingClass>
    <graphicData>
      <texPath>Things/Special/DropPod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>1.9</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(2, 2)</shadowSize>
      <anticipationSound>DropPod_Fall</anticipationSound>
      <anticipationSoundTicks>100</anticipationSoundTicks>
      <impactSound>DropPod_Impact</impactSound>
      <motesPerCell>0</motesPerCell>
    </skyfaller>
  </ThingDef>

</Defs>
