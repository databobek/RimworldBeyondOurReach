<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Kwazaari rework: comm console uplink, scrip favors, lent soldiers; see openspec/specs/kwazaari-rework -->

  <JobDef>
    <defName>BOR_ConnectKwazaari</defName>
    <driverClass>BeyondOurReach.JobDriver_ConnectKwazaari</driverClass>
    <reportString>connecting with the kwazaari.</reportString>
  </JobDef>

  <JobDef>
    <defName>BOR_BoardKwazaariShuttle</defName>
    <driverClass>BeyondOurReach.JobDriver_BoardKwazaariShuttle</driverClass>
    <reportString>boarding the kwazaari shuttle.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <HediffDef>
    <defName>BOR_KwazaariLoan</defName>
    <label>on loan</label>
    <description>This soldier is lent by the Kwazaari. A Kwazaari shuttle will come to take them back, and their gear cannot be taken from them.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.75, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>

  <!-- Blue Kwazaari shuttle; reuses the core shuttle texture, tinted -->
  <ThingDef ParentName="BuildingBase">
    <defName>BOR_KwazaariShuttle</defName>
    <label>kwazaari shuttle</label>
    <description>A sleek blue Kwazaari shuttle.</description>
    <thingClass>BeyondOurReach.Building_KwazaariShuttle</thingClass>
    <tickerType>Normal</tickerType>
    <size>(5,3)</size>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <useHitPoints>false</useHitPoints>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <graphicData>
      <texPath>Things/Building/Misc/Shuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,3)</drawSize>
      <color>(90,140,215)</color>
    </graphicData>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <ThingDef ParentName="BOR_RaidShuttleIncomingBase">
    <defName>BOR_KwazaariShuttleIncoming</defName>
    <label>kwazaari shuttle (incoming)</label>
    <graphicData>
      <color>(90,140,215)</color>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>BOR_KwazaariShuttleLeaving</defName>
    <label>kwazaari shuttle (leaving)</label>
    <graphicData>
      <color>(90,140,215)</color>
    </graphicData>
    <skyfaller>
      <reversed>true</reversed>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <angleCurve>
        <points>
          <li>(0,90)</li>
          <li>(1,70)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.05,2.5)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.1)</li>
          <li>(0.4,0.6)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <!-- Blue drop pods; used for every favor delivery via the faction's dropPodIncoming/dropPodActive -->
  <ThingDef ParentName="DropPodIncoming">
    <defName>BOR_KwazaariPodIncoming</defName>
    <label>kwazaari drop pod (incoming)</label>
    <graphicData>
      <color>(90,140,215)</color>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="ActiveDropPod">
    <defName>BOR_KwazaariPodActive</defName>
    <label>kwazaari drop pod</label>
    <graphicData>
      <color>(90,140,215)</color>
    </graphicData>
  </ThingDef>

  <!-- Things the Kwazaari won't buy. Add more BeyondOurReach.KwazaariTradeBlacklistDef entries (or patch this one) to extend. -->
  <BeyondOurReach.KwazaariTradeBlacklistDef>
    <defName>BOR_KwazaariTradeBlacklist</defName>
    <thingDefs>
      <li>Plasteel</li>
      <li>MedicineUltratech</li>
      <li>BOR_Neutronium</li>
    </thingDefs>
  </BeyondOurReach.KwazaariTradeBlacklistDef>

  <!-- Favors bought with scrip -->
  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_OrbitalShot</defName>
    <label>orbital shot</label>
    <description>The Kwazaari bombard a location of your choice from orbit.</description>
    <workerClass>BeyondOurReach.FavorWorker_Bombardment</workerClass>
    <iconPath>Things/Item/Equipment/WeaponSpecial/OrbitalTargeterBombardment/OrbitalTargeterBombardment</iconPath>
    <order>10</order>
    <cost>10</cost>
    <cooldownDays>5</cooldownDays>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_Food</defName>
    <label>food delivery</label>
    <description>500 packaged survival meals, delivered in Kwazaari drop pods.</description>
    <order>20</order>
    <cost>2</cost>
    <cooldownDays>3</cooldownDays>
    <things>
      <MealSurvivalPack>500</MealSurvivalPack>
    </things>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_SkillTrainers</defName>
    <label>skill trainers</label>
    <description>Three neurotrainers for a skill of your choice.</description>
    <workerClass>BeyondOurReach.FavorWorker_SkillTrainers</workerClass>
    <order>30</order>
    <cost>5</cost>
    <cooldownDays>1</cooldownDays>
    <chosenCount>3</chosenCount>
    <requiredAnyOf>
      <li>ludeon.rimworld.royalty</li>
    </requiredAnyOf>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_Medicine</defName>
    <label>medicine</label>
    <description>50 industrial medicine, delivered in Kwazaari drop pods.</description>
    <order>40</order>
    <cost>2</cost>
    <cooldownDays>5</cooldownDays>
    <things>
      <MedicineIndustrial>50</MedicineIndustrial>
    </things>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_CraftingMaterials</defName>
    <label>crafting materials</label>
    <description>500 steel, 100 plasteel, 50 components and 10 advanced components.</description>
    <order>50</order>
    <cost>1</cost>
    <cooldownDays>1</cooldownDays>
    <things>
      <Steel>500</Steel>
      <Plasteel>100</Plasteel>
      <ComponentIndustrial>50</ComponentIndustrial>
      <ComponentSpacer>10</ComponentSpacer>
    </things>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_BuildingMaterials</defName>
    <label>building materials</label>
    <description>1000 stone blocks of your choice and 1000 wood.</description>
    <workerClass>BeyondOurReach.FavorWorker_StoneBlocks</workerClass>
    <order>60</order>
    <cost>1</cost>
    <cooldownDays>2</cooldownDays>
    <chosenCount>1000</chosenCount>
    <things>
      <WoodLog>1000</WoodLog>
    </things>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_Reinforcements</defName>
    <label>reinforcements</label>
    <description>A Kwazaari shuttle drops off four soldiers under your command for 12 hours. Another shuttle then comes to take them back. Each soldier who does not board it costs 6 scrip, even if that puts you in debt.</description>
    <workerClass>BeyondOurReach.FavorWorker_Reinforcements</workerClass>
    <iconPath>BOR/Things/Factions/KwazaariIcon</iconPath>
    <order>70</order>
    <cost>24</cost>
    <cooldownDays>4</cooldownDays>
    <pawnKind>BOR_Kwazaari_Guardsman</pawnKind>
    <pawnCount>4</pawnCount>
    <loanHours>12</loanHours>
    <lostPawnCost>6</lostPawnCost>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_Psylink</defName>
    <label>psylink</label>
    <description>A psylink neuroformer.</description>
    <order>80</order>
    <cost>4</cost>
    <cooldownDays>15</cooldownDays>
    <things>
      <PsychicAmplifier MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Biotech">1</PsychicAmplifier>
    </things>
    <requiredAnyOf>
      <li>ludeon.rimworld.royalty</li>
      <li>ludeon.rimworld.biotech</li>
    </requiredAnyOf>
  </BeyondOurReach.KwazaariFavorDef>

  <BeyondOurReach.KwazaariFavorDef>
    <defName>BOR_Favor_Mechlink</defName>
    <label>mechlink</label>
    <description>A mechlink.</description>
    <order>90</order>
    <cost>4</cost>
    <cooldownDays>15</cooldownDays>
    <things>
      <Mechlink MayRequire="Ludeon.RimWorld.Biotech">1</Mechlink>
    </things>
    <requiredAnyOf>
      <li>ludeon.rimworld.biotech</li>
    </requiredAnyOf>
  </BeyondOurReach.KwazaariFavorDef>

</Defs>
