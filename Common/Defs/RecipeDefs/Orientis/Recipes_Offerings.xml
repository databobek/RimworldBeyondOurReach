<Defs>
	<!-- Offerings bench recipes. These are written out because a recipeMaker requires a material cost, and these items
	     cost only meditation power (CompOfferingsBench). Work comes from each item's WorkToMake. -->
	<RecipeDef Name="BOR_OrientisOfferingBase" Abstract="True">
		<recipeUsers>
			<li>BOR_Orientis_OfferingsBench</li>
		</recipeUsers>
	</RecipeDef>

