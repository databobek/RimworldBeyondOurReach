<Defs>
    <RecipeDef>
        <defName>BOR_Make_Tenebrite_Bad</defName>
        <label>forge tenebrite</label>
        <description>Forge tenebrite from kwazaari alloy.</description>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Gold</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Uranium</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>BOR_QuasarAlloy</li>
                    </thingDefs>
                </filter>
                <count>25</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>Gold</li>
                <li>Uranium</li>
                <li>BOR_QuasarAlloy</li>
            </thingDefs>
        </fixedIngredientFilter>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <workAmount>10000</workAmount>
        <soundWorking>Recipe_Machining</soundWorking>
        <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
        <skillRequirements>
            <Crafting>15</Crafting>
        </skillRequirements>
        <jobString>Forging Tenebrite</jobString>
        <recipeUsers>
            <li>BOR_Bench_II</li>
        </recipeUsers>
        <products>
            <BOR_Tenebrite>10</BOR_Tenebrite>
        </products>
        <researchPrerequisite>BOR_Research_Analyzer_III</researchPrerequisite>
    </RecipeDef>

