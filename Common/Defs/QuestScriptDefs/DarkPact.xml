<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Started only from the dark mirror (rootSelectionWeight 0). The root rolls the price; its fields tune the counts. -->
  <QuestScriptDef>
    <defName>BOR_DarkPact</defName>
    <autoAccept>true</autoAccept>
    <questAvailableLetterDef>NegativeEvent</questAvailableLetterDef>
    <questAvailableLetterTextIsDescription>true</questAvailableLetterTextIsDescription>
    <root Class="BeyondOurReach.QuestNode_Root_DarkPact">
      <people>40~60</people>
      <animals>100~150</animals>
      <burned>10</burned>
      <guests>5</guests>
      <organs>10</organs>
      <corpses>15</corpses>
      <ossuaryRadius>10</ossuaryRadius>
      <durationDays>7</durationDays>
      <maxSettlementDistance>25</maxSettlementDistance>
    </root>
  </QuestScriptDef>
</Defs>
