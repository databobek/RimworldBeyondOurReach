<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- The gizmo opens the building list; the verb is never cast. -->
	<AbilityDef>
		<defName>BOR_OrientisManifest</defName>
		<label>manifest</label>
		<description>Call an Orientis building into being. Its materials vanish from the map and the finished building appears where you choose.</description>
		<iconPath>BOR/UI/Orientis/Manifest</iconPath>
		<gizmoClass>BeyondOurReach.Command_OrientisManifest</gizmoClass>
		<targetRequired>false</targetRequired>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
		<displayOrder>200</displayOrder>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<range>1.9</range>
			<drawAimPie>false</drawAimPie>
			<requireLineOfSight>false</requireLineOfSight>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>
	</AbilityDef>
</Defs>
