  <ThingDef Name="BOR_NoQualityWearableBase_II" ParentName="ApparelNoQualityBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_II</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_II</li>
      </recipeUsers>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
  </ThingDef>

  <!-- Headgear -->

  <ThingDef ParentName="BOR_QualityHeadgearBase_II">
    <defName>BOR_Quasar_Research_Integration_Helm</defName>
    <label>kwazaari research integration helm</label>
    <description>A unified kwazaari alloy helm that consolidates the quantum rebreather and forge calibration optics into a single system. Its integrated circuitry alternates between filtration monitoring for hazardous synthesis work and thermal gradient tracking for forge alignment — switching seamlessly as the task demands.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/EltexHelmet/EltexHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.90</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>52500</WorkToMake>
      <MaxHitPoints>350</MaxHitPoints>
      <Mass>1.20</Mass>
      <Flammability>0.22</Flammability>
      <ArmorRating_Sharp>1.95</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.75</ArmorRating_Blunt>
      <ArmorRating_Heat>0.92</ArmorRating_Heat>
      <Insulation_Cold>6</Insulation_Cold>
      <Insulation_Heat>3.75</Insulation_Heat>
      <EquipDelay>2.20</EquipDelay>
      <MarketValue>8500</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <BOR_QuantumForging>0.13</BOR_QuantumForging>
      <BOR_BionicCraftingSpeed>0.13</BOR_BionicCraftingSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_Headgear_II</li>
    </thingCategories>
    <costList>
      <BOR_QuasarAlloy>55</BOR_QuasarAlloy>
      <BOR_ComponentII>2</BOR_ComponentII>
    </costList>
    <apparel>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/EltexHelmet/EltexHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_II</li>
      <li>BOR_Tech_II</li>
    </tradeTags>
  </ThingDef>

