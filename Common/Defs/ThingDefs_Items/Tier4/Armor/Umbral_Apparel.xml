	</ThingDef>

	<ThingDef Name="BOR_UmbralExoskullBase" ParentName="BOR_UmbralExoApparelBase" Abstract="True">
		<description>Living Umbral crystal grown over the skull. It cannot be taken off.</description>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
			<canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
		<modExtensions>
			<li Class="BeyondOurReach.DefModExtension_DarkThing" />
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="BOR_UmbralExoskullBase">
		<defName>BOR_UmbralExoskull_Camo</defName>
		<label>umbral exoskull (camo)</label>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/umbralcamo/UmbralCamoHelm_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/umbralcamo/UmbralCamoHelm</wornGraphicPath>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BOR_UmbralExoskullBase">
		<defName>BOR_UmbralExoskull_Utility</defName>
		<label>umbral exoskull (utility)</label>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/umbralutility/UmbralUtilityHelm_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/umbralutility/UmbralUtilityHelm</wornGraphicPath>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BOR_UmbralExoskullBase">
		<defName>BOR_UmbralExoskull_Combat</defName>
		<label>umbral exoskull (combat)</label>
		<statBases>
			<!-- Tier 3 power armor helmet, times 1.3. -->
			<ArmorRating_Sharp>4.7</ArmorRating_Sharp>
			<ArmorRating_Blunt>2.1</ArmorRating_Blunt>
			<ArmorRating_Heat>2.15</ArmorRating_Heat>
		</statBases>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/umbralwar/UmbralWarHelm_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/umbralwar/UmbralWarHelm</wornGraphicPath>
