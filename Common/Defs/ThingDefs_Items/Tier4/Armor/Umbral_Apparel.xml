<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--
		Umbral exoskeleton, exoskull and utility pod forms. These are never made or traded: the Umbral hediffs put them
		on the pawn (locked) and destroy them when they leave it. Textures are placeholders copied from Tier 3 gear.
	-->
	<ThingDef Name="BOR_UmbralExoApparelBase" ParentName="ApparelNoQualityBase" Abstract="True">
		<techLevel>Archotech</techLevel>
		<destroyOnDrop>true</destroyOnDrop>
		<tradeability>None</tradeability>
		<smeltable>false</smeltable>
		<burnableByRecipe>false</burnableByRecipe>
		<generateCommonality>0</generateCommonality>
		<thingCategories Inherit="False" />
		<statBases>
			<MaxHitPoints>5000</MaxHitPoints>
			<Mass>0</Mass>
			<Flammability>0</Flammability>
			<EquipDelay>1</EquipDelay>
			<MarketValue>0</MarketValue>
			<Insulation_Cold>40</Insulation_Cold>
			<Insulation_Heat>20</Insulation_Heat>
		</statBases>
	</ThingDef>

	<ThingDef Name="BOR_UmbralExoskeletonBase" ParentName="BOR_UmbralExoApparelBase" Abstract="True">
		<description>Living Umbral crystal grown over the body. It cannot be taken off.</description>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Hands</li>
				<li>Feet</li>
			</bodyPartGroups>
			<layers>
				<li>OnSkin</li>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
			<canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
		<!-- Combat Extended carry capacity: 30% under the Tenebral backpack (bulk 183) and Tenebral power armor (weight 80).
		     Utility doubles it. Ignored without CE. -->
		<equippedStatOffsets>
			<CarryBulk MayRequire="CETeam.CombatExtended">128</CarryBulk>
			<CarryWeight MayRequire="CETeam.CombatExtended">56</CarryWeight>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="BeyondOurReach.DefModExtension_DarkThing" />
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="BOR_UmbralExoskeletonBase">
		<defName>BOR_UmbralExoskeleton_Camo</defName>
		<label>umbral exoskeleton (camo)</label>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/umbralcamo/UmbralCamo_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/umbralcamo/UmbralCamo</wornGraphicPath>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BOR_UmbralExoskeletonBase">
		<defName>BOR_UmbralExoskeleton_Utility</defName>
		<label>umbral exoskeleton (utility)</label>
		<equippedStatOffsets Inherit="False">
			<CarryBulk MayRequire="CETeam.CombatExtended">256</CarryBulk>
			<CarryWeight MayRequire="CETeam.CombatExtended">112</CarryWeight>
		</equippedStatOffsets>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/umbralutility/UmbralUtility_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/umbralutility/UmbralUtility</wornGraphicPath>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BOR_UmbralExoskeletonBase">
		<defName>BOR_UmbralExoskeleton_Combat</defName>
		<label>umbral exoskeleton (combat)</label>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/umbralwar/UmbralWar_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/umbralwar/UmbralWar</wornGraphicPath>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="BOR_UmbralExoskeletonBase">
		<defName>BOR_UmbralExoskeleton_None</defName>
		<label>umbral exoskeleton</label>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/umbralcamo/UmbralCamo_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/umbralcamo/UmbralCamo</wornGraphicPath>
