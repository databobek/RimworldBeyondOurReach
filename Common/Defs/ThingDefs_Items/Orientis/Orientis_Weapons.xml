	<ThingDef ParentName="BOR_OrientisGunBase">
		<defName>BOR_Orientis_PlasmaCrossbow</defName>
		<label>plasma crossbow</label>
		<description>A heavy crossbow that throws a bolt of plasma that bursts on the target. The shockwave stuns Umbrals, Tenebrals and anomaly creatures. It needs a long moment to charge.</description>
		<graphicData>
			<texPath>BOR/Things/Item/Equipment/orientis/boombow</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<MarketValue>6000</MarketValue>
			<Mass>6</Mass>
			<RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>BOR_Bullet_OrientisPlasmaBolt</defaultProjectile>
				<warmupTime>3</warmupTime>
				<range>27.9</range>
				<forcedMissRadius>1.9</forcedMissRadius>
				<soundCast>Shot_ChargeBlaster</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>12</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
	</ThingDef>

