	<!-- Main melee -->
	<ThingDef ParentName="BOR_OrientisMeleeSharpBase">
		<defName>BOR_Orientis_PowerAxe</defName>
		<label>crusader power axe</label>
		<description>A broad crusader axe with a charged edge that burns what it cuts. Heavy and slow, it waits for one perfect strike.</description>
		<graphicData>
			<texPath>BOR/Things/Item/Equipment/orientis/axe</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<WorkToMake>30000</WorkToMake>
			<MarketValue>4000</MarketValue>
			<Mass>3.5</Mass>
		</statBases>
		<tools>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>50</power>
				<cooldownTime>2.9</cooldownTime>
				<armorPenetration>1.2</armorPenetration>
				<extraMeleeDamages>
					<li>
						<def>Flame</def>
						<amount>8</amount>
						<chance>1</chance>
					</li>
				</extraMeleeDamages>
			</li>
		</tools>
		<comps>
			<li>
				<compClass>CompColorable</compClass>
			</li>
			<li Class="BeyondOurReach.CompProperties_WeaponGlow">
				<texPath>BOR/Things/Item/Equipment/orientis/axe_glow</texPath>
			</li>
		</comps>
	</ThingDef>

