	<!-- Crossbows. Damage sits between Solar and Quasar; the debuffs are what the weapons are for. -->
	<DamageDef ParentName="Bomb">
		<defName>BOR_OrientisBlast</defName>
		<label>plasma blast</label>
		<workerClass>BeyondOurReach.DamageWorker_OrientisBlast</workerClass>
		<modExtensions>
			<li Class="BeyondOurReach.DefModExtension_TargetStun">
				<stunTicks>120</stunTicks>
			</li>
		</modExtensions>
	</DamageDef>

	<DamageDef ParentName="Bullet">
		<defName>BOR_OrientisLaser</defName>
		<label>laser bolt</label>
		<workerClass>BeyondOurReach.DamageWorker_OrientisLaser</workerClass>
	</DamageDef>

	<HediffDef>
		<defName>BOR_OrientisArmorBreak</defName>
		<label>armor strain</label>
		<description>A laser hit has strained the armor. It may fail.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>true</isBad>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>180</disappearsAfterTicks>
			</li>
			<li Class="BeyondOurReach.HediffCompProperties_OrientisArmorBreak">
				<disableChance>0.3</disableChance>
				<lockSeconds>30</lockSeconds>
			</li>
		</comps>
	</HediffDef>

