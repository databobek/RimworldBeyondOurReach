	<!-- Light -->
	<ThingDef ParentName="BOR_OrientisArmorBase">
		<defName>BOR_Orientis_SaladinArmor</defName>
		<label>confractor armor</label>
		<description>Light mail and flowing cloth in the style of the First Crusade. It barely slows the wearer.</description>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/orientislight/OrientisLight</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>30000</WorkToMake>
			<MarketValue>4000</MarketValue>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>6</Mass>
			<Flammability>0.3</Flammability>
			<ArmorRating_Sharp>1.0</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
			<ArmorRating_Heat>0.55</ArmorRating_Heat>
			<Insulation_Cold>20</Insulation_Cold>
