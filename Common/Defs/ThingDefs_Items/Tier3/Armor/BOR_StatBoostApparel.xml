  <ThingDef Name="BOR_NoQualityWearableBase_III" ParentName="ApparelNoQualityBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_III</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_III</li>
      </recipeUsers>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="BOR_NoQualityWearableBase_III">
    <defName>BOR_Tenebral_Apparel_Backpack</defName>
    <label>tenebral backpack</label>
    <description>A nearly-living mechanical pack, cultivated from Tenebral crystals that warp and reorganize tissue. Its Crystal Core hardens into a ridged shell and bonds directly to the wearer’s back.
      When an item is placed inside — tools, rations, cartridges, relics — the chamber tightens around it, forming a protective layer that adjusts its rigidity based on the object’s mass and fragility. Some packs emit a faint harmonic hum — speaking small nothings into the ear of its charge.</description>
    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/TenebralBackpack/tenebral_backpack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>2</drawSize>
    </graphicData>
    <apparel>
      <wornGraphicData>
        <male>
          <scale>(1.3,1.3)</scale>
        </male> <!-- // (0.75,0.75) //-->
        <female>
          <scale>(1.3,1.3)</scale>
        </female> <!-- // (0.75,0.75) //-->
        <thin>
          <scale>(1.3,1.3)</scale>
        </thin> <!-- // (0.7,0.7) //-->
        <hulk>
          <scale>(1.3,1.3)</scale>
        </hulk> <!-- // (0.9,0.9) //-->
        <fat>
          <scale>(1.3,1.3)</scale>
        </fat> <!-- // (0.9,0.9) //-->
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/TenebralBackpack/tenebral_backpack</wornGraphicPath>
    </apparel>
    <equippedStatOffsets>
      <CarryingCapacity>160</CarryingCapacity>
      <VEF_MassCarryCapacity MayRequire="oskarpotocki.vanillafactionsexpanded.core">300</VEF_MassCarryCapacity>
    </equippedStatOffsets>
    <statBases>
      <Mass>0.2</Mass>
      <Flammability>0.05</Flammability>
      <Insulation_Cold>18</Insulation_Cold>
      <EquipDelay>0.35</EquipDelay>
    </statBases>
    <costList>
      <BOR_Tenebrite>50</BOR_Tenebrite>
      <BOR_ComponentIII>1</BOR_ComponentIII>
    </costList>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>BOR_Tech_III</li>
    </tradeTags>
  </ThingDef>

</Defs>