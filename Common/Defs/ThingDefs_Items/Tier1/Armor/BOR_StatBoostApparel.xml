        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_I</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
  </ThingDef>

