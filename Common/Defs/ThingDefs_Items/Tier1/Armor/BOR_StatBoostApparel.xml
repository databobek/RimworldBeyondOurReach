  <ThingDef ParentName="BOR_NoQualityWearableBase">
    <defName>BOR_Solar_Apparel_Backpack</defName>
    <label>solar backpack</label>
    <description>This pack is built with a Sunsteel spine — light and strong, it distributes weight and shifts imperceptibly with the wearer’s movement. The outer shell is woven with thin solar filaments that feed the spine with a constant trickle of power, giving the pack a faint warm pulse. Solarite Cosplayers will tell you Grandmother Wennie designed this herself, shortly after her trade ship collided with the celestial body and Sunsteel was discovered. You can come to your own conclusion.</description>
    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/SolarBackpack/solar_backpack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>2</drawSize>
    </graphicData>
    <apparel>
      <wornGraphicData>
        <male>
          <scale>(1.3,1.3)</scale>
        </male> <!-- // (0.75,0.75) //-->
        <female>
          <scale>(1.3,1.3)</scale>
        </female> <!-- // (0.75,0.75) //-->
        <thin>
          <scale>(1.3,1.3)</scale>
        </thin> <!-- // (0.7,0.7) //-->
        <hulk>
          <scale>(1.3,1.3)</scale>
        </hulk> <!-- // (0.9,0.9) //-->
        <fat>
          <scale>(1.3,1.3)</scale>
        </fat> <!-- // (0.9,0.9) //-->
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/SolarBackpack/solar_backpack</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <equippedStatOffsets>
      <CarryingCapacity>60</CarryingCapacity>
      <VEF_MassCarryCapacity MayRequire="oskarpotocki.vanillafactionsexpanded.core">100</VEF_MassCarryCapacity>
    </equippedStatOffsets>
    <statBases>
      <Mass>0.5</Mass>
      <Flammability>0.2</Flammability>
      <Insulation_Cold>6</Insulation_Cold>
      <EquipDelay>0.50</EquipDelay>
    </statBases>
    <costList>
      <BOR_Sunweave>50</BOR_Sunweave>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
