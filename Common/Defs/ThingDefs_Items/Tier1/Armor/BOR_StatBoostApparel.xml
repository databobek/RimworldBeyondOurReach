    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/CalibrationVisor/calibration_visor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.60</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>3425</MarketValue>
      <WorkToMake>22000</WorkToMake>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>0.88</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.00</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.46</ArmorRating_Heat>
      <Insulation_Cold>3</Insulation_Cold>
      <Insulation_Heat>1.25</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <BOR_QuantumForging>0.10</BOR_QuantumForging>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_Headgear_I</li>
    </thingCategories>
    <costList>
      <BOR_Sunsteel>31</BOR_Sunsteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/CalibrationVisor/calibration_visor</wornGraphicPath>
