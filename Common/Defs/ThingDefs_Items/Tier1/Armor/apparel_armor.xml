<Defs>

  <ThingDef ParentName="ArmorMachineableBase">
    <defName>BOR_Bionic_Assembly_Harness</defName>
    <label>bionic assembly harness</label>
    <description>A reinforced sunsteel vest with integrated assembly bracing. The molded plates protect the torso and shoulders while rigid haptic guides support precise bionic assembly work.</description>
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
        <li>FlakArmor</li>
      </researchPrerequisites>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>220</displayPriority>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
      </recipeUsers>
    </recipeMaker>
    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/AssemblyHarness/assembly_harness</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.90</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>6750</MarketValue>
      <WorkToMake>40500</WorkToMake>
      <MaxHitPoints>350</MaxHitPoints>
      <Mass>5</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>1.25</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
      <ArmorRating_Heat>0.57</ArmorRating_Heat>
      <Insulation_Cold>40</Insulation_Cold>
      <Insulation_Heat>11</Insulation_Heat>
      <EquipDelay>9</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.50</ToxicEnvironmentResistance>
      <MoveSpeed>-0.09</MoveSpeed>
      <BOR_BionicCraftingSpeed>0.13</BOR_BionicCraftingSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_I</li>
    </thingCategories>
    <costList>
      <BOR_Sunweave>33</BOR_Sunweave>
      <BOR_Sunsteel>77</BOR_Sunsteel>
      <Uranium>11</Uranium>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/AssemblyHarness/assembly_harness</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>HiTechArmor</li>
        <li>BOR_Military_I</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_I</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
  </ThingDef>

