<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>BOR_Turret_Ranger_TII</defName>
        <label>ranger railgun turret</label>
        <description>A precision long-range railgun turret. It fires rarely, but when it does, the projectile leaves the barrel at extreme velocity with near-perfect accuracy.</description>
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>BOR/Things/Building/tier2/turret/base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3.5,3.5)</drawSize>
        </graphicData>
        <uiIconPath>BOR/Things/Building/tier2/turret/turret</uiIconPath>
        <size>(4,4)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <tickerType>Normal</tickerType>
        <fillPercent>0.95</fillPercent>
        <blockWind>true</blockWind>
        <canOverlapZones>false</canOverlapZones>
        <statBases>
            <MaxHitPoints>1500</MaxHitPoints>
            <WorkToBuild>35000</WorkToBuild>
            <Flammability>0.25</Flammability>
            <Beauty>-8</Beauty>
            <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
        </statBases>
        <costList>
            <BOR_Sunsteel>616</BOR_Sunsteel>
            <BOR_QuasarAlloy>176</BOR_QuasarAlloy>
            <BOR_ComponentII>26</BOR_ComponentII>
        </costList>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>BOR_Turret_Ranger_TII_Gun</turretGunDef>
            <turretTopDrawSize>4.5</turretTopDrawSize>
            <turretBurstWarmupTime>1.8</turretBurstWarmupTime>
            <turretBurstCooldownTime>4.2</turretBurstCooldownTime>
        </building>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>16.58</explosiveRadius>
                <explosiveDamageType>BombSuper</explosiveDamageType>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>12500</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Breakdownable" />
        </comps>
        <researchPrerequisites>
            <li>BOR_Research_RangerTurret_II</li>
        </researchPrerequisites>
        <designationCategory>BOR</designationCategory>
        <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>BOR_Turret_Ranger_TII_Gun</defName>
        <techLevel>Ultra</techLevel>
        <label>ranger railgun assembly</label>
        <description>A precision railgun assembly built for the Ranger turret. Its hypervelocity slug is designed for long-range interdiction and hard-target punching.</description>
        <graphicData>
            <texPath>BOR/Things/Building/tier2/turret/turret</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
        </graphicData>
        <weaponTags>
            <li>TurretGun</li>
        </weaponTags>
        <statBases>
          <RoyalFavorValue>3</RoyalFavorValue>
            <Mass>352</Mass>
            <Flammability>0</Flammability>
            <DeteriorationRate>0</DeteriorationRate>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>BOR_Bullet_Ranger_TII</defaultProjectile>
                <minRange>5</minRange>
                <range>213</range>
                <burstShotCount>5</burstShotCount>
                <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
                <consumeFuelPerShot>1</consumeFuelPerShot>
                <soundCast>BOR_Railgun</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>10</muzzleFlashScale>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>BOR_Bullet_Ranger_TII</defName>
        <label>ranger railgun slug</label>
        <graphicData>
            <texPath>Things/Projectile/ShellHighExplosive</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>173</damageAmountBase>
            <stoppingPower>3.75</stoppingPower>
            <speed>444</speed>
            <armorPenetrationBase>1.58</armorPenetrationBase>
        </projectile>
    </ThingDef>

    <!-- ==================== Negotiator-class Station Defense System (Tier II) ==================== -->

    <ThingDef ParentName="BuildingBase">
        <defName>BOR_NegotiatorStationDefenseSystem_TII</defName>
        <hasInteractionCell>False</hasInteractionCell>
        <interactionCellOffset />
        <label>Negotiator-class station defense system</label>
        <description>A station-grade spinal artillery system that has absolutely no business being planet-side. The colony mounting rig barely tolerates it, the power grid hates it, and every shot feels like an industrial accident weaponized on purpose.</description>
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>BOR/Things/Item/Equipment/weaponranged/gen2/artillery/chungusbase</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(7,7)</drawSize>
        </graphicData>
        <uiIconPath>BOR/Things/Item/Equipment/weaponranged/gen2/artillery/chungus</uiIconPath>
        <size>(7,7)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <tickerType>Normal</tickerType>
        <fillPercent>0.995</fillPercent>
        <blockWind>true</blockWind>
        <canOverlapZones>false</canOverlapZones>
        <statBases>
            <MaxHitPoints>2000</MaxHitPoints>
            <WorkToBuild>1800000</WorkToBuild>
            <Flammability>0</Flammability>
            <Beauty>-67</Beauty>
            <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
        </statBases>
        <costList>
            <BOR_Neutronium>2640</BOR_Neutronium>
            <BOR_QuasarAlloy>1320</BOR_QuasarAlloy>
            <BOR_ComponentII>132</BOR_ComponentII>
        </costList>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>BOR_NegotiatorStationDefenseSystem_TII_Gun</turretGunDef>
            <turretTopDrawSize>11</turretTopDrawSize>
            <turretTopOffset>(0,1.8)</turretTopOffset>
            <turretBurstWarmupTime>8.25</turretBurstWarmupTime>
            <turretBurstCooldownTime>198</turretBurstCooldownTime>
        </building>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>22</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>150001</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Cracker shells</fuelLabel>
                <fuelGizmoLabel>Cracker shells</fuelGizmoLabel>
                <fuelFilter>
                    <thingDefs>
                        <li>BOR_Shell_NegotiatorCracker_TII</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>3</fuelCapacity>
                <initialFuelPercent>0</initialFuelPercent>
                <autoRefuelPercent>0.5</autoRefuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>0</minimumFueledThreshold>
                <atomicFueling>false</atomicFueling>
                <fuelMultiplier>1</fuelMultiplier>
                <factorByDifficulty>false</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <outOfFuelMessage>Cannot shoot: Out of Cracker shells</outOfFuelMessage>
                <fuelIconPath>Things/Projectile/ShellHighExplosive</fuelIconPath>
            </li>
        </comps>
        <researchPrerequisites>
            <li>BOR_Research_NegotiatorArtillery_II</li>
        </researchPrerequisites>
        <designationCategory>BOR</designationCategory>
        <constructionSkillPrerequisite>18</constructionSkillPrerequisite>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>BOR_NegotiatorStationDefenseSystem_TII_Gun</defName>
        <techLevel>Ultra</techLevel>
        <label>Negotiator-class spinal cannon</label>
        <description>A scaled-down station spinal weapon adapted for local emplacement. Every discharge is excessive by any sane military standard.</description>
        <graphicData>
            <texPath>BOR/Things/Item/Equipment/weaponranged/gen2/artillery/chungus</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(7,7)</drawSize>
        </graphicData>
        <weaponTags>
            <li>Artillery_BaseDestroyer</li>
        </weaponTags>
        <statBases>
          <RoyalFavorValue>3</RoyalFavorValue>
            <DeteriorationRate>0</DeteriorationRate>
            <Mass>35200</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>BOR_Bullet_NegotiatorCracker_TII</defaultProjectile>
                <forcedMissRadius>2</forcedMissRadius>
                <forcedMissRadiusClassicMortars>4</forcedMissRadiusClassicMortars>
                <requireLineOfSight>false</requireLineOfSight>
                <minRange>40</minRange>
                <range>1200</range>
                <burstShotCount>1</burstShotCount>
                <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
                <soundCast>BOR_Railgun_II</soundCast>
                <muzzleFlashScale>30</muzzleFlashScale>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
                <consumeFuelPerShot>1</consumeFuelPerShot>
            </li>
        </verbs>
    </ThingDef>

    <ThingDef ParentName="ResourceBase">
        <defName>BOR_Shell_NegotiatorCracker_TII</defName>
        <techLevel>Ultra</techLevel>
        <label>Cracker shell</label>
        <description>A catastrophic siege shell intended for station guns, repurposed into a ground launcher that should probably never have been approved. Impact radius is less "munition" and more "regional event".</description>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Projectile/ShellHighExplosive</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.2</drawSize>
        </graphicData>
        <stackLimit>10</stackLimit>
        <statBases>
          <RoyalFavorValue>1</RoyalFavorValue>
            <MaxHitPoints>100</MaxHitPoints>
            <Mass>132</Mass>
            <MarketValue>10000</MarketValue>
            <Flammability>0.6</Flammability>
            <DeteriorationRate>1.0</DeteriorationRate>
        </statBases>
        <tradeTags>
            <li>BOR_Tech_II</li>
        </tradeTags>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>60</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
                <wickTicks>
                    <min>30</min>
                    <max>60</max>
                </wickTicks>
            </li>
        </comps>
        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <effectWorking>Cook</effectWorking>
            <soundWorking>Recipe_Machining</soundWorking>
            <workAmount>850000</workAmount>
            <targetCountAdjustment>1</targetCountAdjustment>
            <workSkill>Crafting</workSkill>
            <recipeUsers>
                <li>BOR_Bench_II</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>18</Crafting>
            </skillRequirements>
            <researchPrerequisite>BOR_Research_NegotiatorArtillery_II</researchPrerequisite>
        </recipeMaker>
        <costList>
            <BOR_Neutronium>1100</BOR_Neutronium>
            <BOR_QuasarAlloy>660</BOR_QuasarAlloy>
            <BOR_ComponentII>11</BOR_ComponentII>
        </costList>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>BOR_Bullet_NegotiatorCracker_TII</defName>
        <label>Cracker shell projectile</label>
        <graphicData>
            <texPath>Things/Projectile/ShellHighExplosive</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>2.2</drawSize>
        </graphicData>
        <thingClass>Projectile_Explosive</thingClass>
        <projectile>
            <damageDef>BombSuper</damageDef>
            <damageAmountBase>15000</damageAmountBase>
            <speed>48</speed>
            <explosionRadius>1000</explosionRadius>
            <flyOverhead>true</flyOverhead>
            <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
            <soundExplode>MortarBomb_Explode</soundExplode>
            <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
        </projectile>
    </ThingDef>

</Defs>