<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- What the Path of Light leaves of a tenebral or Umbral building. Building_DarkHusk draws the building it was, so
	     these only differ in footprint. A new dark building with a new size needs a husk here. -->
	<ThingDef Name="BOR_DarkHuskBase" ParentName="BuildingBase" Abstract="True">
		<thingClass>BeyondOurReach.Building_DarkHusk</thingClass>
		<label>dead building</label>
		<description>The light burned whatever moved in this. It does nothing now, and can only be taken down for no materials.</description>
		<graphicData>
			<texPath>BOR/Things/Factions/TenebralIcon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.5</fillPercent>
		<rotatable>true</rotatable>
		<tickerType>Never</tickerType>
		<tradeability>None</tradeability>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToBuild>1000</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<building>
			<isInert>true</isInert>
		</building>
	</ThingDef>

	<ThingDef ParentName="BOR_DarkHuskBase">
		<defName>BOR_DarkHusk_1x1_Shell</defName>
		<size>(1,1)</size>
	</ThingDef>

	<ThingDef ParentName="BOR_DarkHuskBase">
		<defName>BOR_DarkHusk_1x4_Shell</defName>
		<size>(1,4)</size>
	</ThingDef>

