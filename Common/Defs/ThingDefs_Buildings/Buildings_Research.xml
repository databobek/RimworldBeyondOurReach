<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>BOR_Research_Unlocker_I</defName>
        <label>solar fluid simulation array</label>
        <description>Increases research speed when placed near hi-tech research bench and unlocks Solarite research projects. Each research bench can only use one solar fluid simulation array</description>
        <thingClass>Building_ResearchBench</thingClass>
        <graphicData>
            <texPath>BOR/Things/Building/tier1/research_unlocker</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2.3, 2.3)</drawSize>
            <drawOffset>(0,4,0.2)</drawOffset>
            <drawRotated>false</drawRotated>
        </graphicData>
        <uiIconScale>0.85</uiIconScale>
        <researchPrerequisites>
            <li>BOR_Research_Analyzer_I</li>
        </researchPrerequisites>
        <size>(2,2)</size>
        <rotatable>true</rotatable>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <castEdgeShadows>true</castEdgeShadows>
        <fillPercent>0.5</fillPercent>
        <designationHotKey>Misc4</designationHotKey>
        <designationCategory>BOR</designationCategory>
        <minifiedDef>MinifiedThing</minifiedDef>
        <canOverlapZones>false</canOverlapZones>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
        <statBases>
            <MaxHitPoints>292</MaxHitPoints>
            <WorkToBuild>15000</WorkToBuild>
            <Mass>99</Mass>
            <Flammability>0.833</Flammability>
        </statBases>
        <costList>
            <Plasteel>40</Plasteel>
            <BOR_Sunsteel>55</BOR_Sunsteel>
            <ComponentSpacer>9</ComponentSpacer>
        </costList>
        <building>
            <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
        </building>
        <comps>
            <li Class="CompProperties_ReportWorkSpeed">
                <workSpeedStat>ResearchSpeedFactor</workSpeedStat>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>4167</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Facility">
                <statOffsets>
                    <ResearchSpeedFactor>0.75</ResearchSpeedFactor>
                </statOffsets>
                <maxSimultaneous>4</maxSimultaneous>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>BOR_Kylar_Xar_Computer</li>
                    <li>MultiAnalyzer</li>
                    <li>BOR_Research_Unlocker_I</li>
                    <li MayRequireAnyOf="hol.rimputersforked,joeyjoejoeshabidoo.Rimputers1.4">Rimputer_quantumcomputer</li>
                    <li MayRequireAnyOf="hol.rimputersforked,joeyjoejoeshabidoo.Rimputers1.4">RP_TapeStorage</li>
                    <li MayRequireAnyOf="hol.rimputersforked,joeyjoejoeshabidoo.Rimputers1.4">RP_Server</li>
                    <li MayRequireAnyOf="hol.rimputersforked,joeyjoejoeshabidoo.Rimputers1.4">RP_SuperComputer</li>
                    <li MayRequire="4loris4.MoreLinkables">AdvancedMultiAnalyzer</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_Autoclave</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_Centrifuge</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_Incinerator</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_PersonalComputer</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_TabletopCentrifuge</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_TabletopStove</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_TabletopLabMachine</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_TabletopOscilloscope</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_TabletopLabScanner</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_TabletopLabTubeRack</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_TabletopLabMicroscope</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_BotanicalEnclosure</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_ServerRack</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_Still</li>
                    <li MayRequire="hobbes.bamba.evenmorelinkables16">HobbesLink_Rotovape</li>
                </linkableFacilities>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
        </placeWorkers>
        <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
        <designatorDropdown>BOR_Unlockers</designatorDropdown>
    </ThingDef>

