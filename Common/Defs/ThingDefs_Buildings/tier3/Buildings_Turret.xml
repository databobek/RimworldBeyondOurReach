<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Built up by the dread beacon's field. Source/Tenebral/DarkField.cs drives severity: it rises with time in the field
         scaled by psychic sensitivity, falls at 1/60 per second outside it, starts confusion at 0.33 and a rage at 1. -->
    <HediffDef>
        <defName>BOR_DarkInfluence</defName>
        <label>dark influence</label>
        <description>A tenebral field is pressing on this mind. The longer it stays inside, the darker its thoughts become: first a creeping mist that clouds judgement, then a rage that drowns out everything else. It fades once the pawn leaves the field.</description>
        <hediffClass>BeyondOurReach.Hediff_DarkInfluence</hediffClass>
        <defaultLabelColor>(0.75,0.15,0.2)</defaultLabelColor>
        <initialSeverity>0.001</initialSeverity>
        <minSeverity>0</minSeverity>
        <maxSeverity>1</maxSeverity>
        <isBad>true</isBad>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
            </li>
            <li>
                <minSeverity>0.33</minSeverity>
                <overrideLabel>dark mist</overrideLabel>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.7</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>1</minSeverity>
                <overrideLabel>dark rage</overrideLabel>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.7</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <!-- The def name is the old pacifier turret's, so pacifiers already placed in saves become beacons. -->
    <ThingDef ParentName="BuildingBase">
        <defName>BOR_Turret_Pacifier_TIII</defName>
        <label>tenebral dread beacon</label>
        <description>A tenebral pylon that bleeds a red field into its surroundings. Anyone who lingers inside feels it: a dark influence at first, a confusing mist after about 20 seconds, and a berserk rage after about a minute. Psychic sensitivity sets the pace, from immune at 0% to twice as fast at 200%. Tenebral psychotics and Umbrals are immune and Orientis resist half of it. It does not tell friend from foe.</description>
        <thingClass>Building</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>BOR/Things/Building/tier3/turret/base2</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(4,4)</drawSize>
        </graphicData>
        <uiIconPath>BOR/Things/Building/tier3/turret/turret</uiIconPath>
        <size>(2,2)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <tickerType>Normal</tickerType>
        <fillPercent>0.95</fillPercent>
        <blockWind>true</blockWind>
        <canOverlapZones>false</canOverlapZones>
        <statBases>
            <MaxHitPoints>2000</MaxHitPoints>
            <WorkToBuild>26000</WorkToBuild>
            <Flammability>0.15</Flammability>
            <Beauty>-8</Beauty>
        </statBases>
        <costList>
            <BOR_Tenebrite>160</BOR_Tenebrite>
            <BOR_QuasarAlloy>70</BOR_QuasarAlloy>
            <BOR_ComponentIII>4</BOR_ComponentIII>
        </costList>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
        </building>
        <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        <placeWorkers>
            <li>BeyondOurReach.PlaceWorker_DarkFieldRadius</li>
        </placeWorkers>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>10.9</explosiveRadius>
                <explosiveDamageType>BombSuper</explosiveDamageType>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>50000</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Breakdownable" />
            <li Class="BeyondOurReach.CompProperties_DarkField">
                <radius>15.9</radius>
                <hediff>BOR_DarkInfluence</hediff>
                <secondsToRage>60</secondsToRage>
                <maxSensitivity>2</maxSensitivity>
                <orientisFactor>0.5</orientisFactor>
            </li>
        </comps>
        <researchPrerequisites>
            <li>BOR_Research_PacifierTurret_III</li>
        </researchPrerequisites>
        <designationCategory>BOR</designationCategory>
        <constructionSkillPrerequisite>14</constructionSkillPrerequisite>
        <modExtensions>
            <li Class="BeyondOurReach.DefModExtension_TenebralBuilding" />
        </modExtensions>
    </ThingDef>

</Defs>
