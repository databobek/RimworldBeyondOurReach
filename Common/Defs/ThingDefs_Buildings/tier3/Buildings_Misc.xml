<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>BOR_Vitals_III</defName>
    <label>umbral soul anchor</label>
    <description>The tenebral version of a vitals monitor</description>
    <graphicData>
      <texPath>BOR/Things/Building/tier3/medicine_bench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5,3.5 )</drawSize>
    </graphicData>
    <researchPrerequisites>
      <li>BOR_Research_Medicine_III</li>
    </researchPrerequisites>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.6</fillPercent>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Mass>50</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <BOR_QuasarAlloy>90</BOR_QuasarAlloy>
      <BOR_Tenebrite>30</BOR_Tenebrite>
      <BOR_ComponentIII>1</BOR_ComponentIII>
    </costList>
    <designationCategory>BOR</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>50000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Facility">
        <statOffsets>
          <MedicalTendQualityOffset>0.4</MedicalTendQualityOffset>
          <ImmunityGainSpeedFactor>0.1</ImmunityGainSpeedFactor>
          <SurgerySuccessChanceFactor>0.3</SurgerySuccessChanceFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
        <mustBePlacedAdjacent>true</mustBePlacedAdjacent>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>14</constructionSkillPrerequisite>
    <uiIconScale>1</uiIconScale>
    <rotatable>false</rotatable>
    <modExtensions>
      <li Class="BeyondOurReach.DefModExtension_UmbralOnly" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>BOR_ToolCabinet_III</defName>
    <label>umbral manufacturer</label>
    <designatorDropdown>BOR_ToolCabinets</designatorDropdown>
    <description>Increases work speed by a frightening degree when placed near a workbench. One workbench can use up to five dark manufacturers.</description>
    <graphicData>
      <texPath>BOR/Things/Building/tier3/production_bench_linkable/production_bench_linkable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5.7,5.7)</drawSize>
      <drawOffset>(0,4,0.4)</drawOffset>
      <drawOffsetWest>(0,4,0)</drawOffsetWest>
      <drawOffsetEast>(0,4,0)</drawOffsetEast>
    </graphicData>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>32</pathCost>
    <statBases>
      <MaxHitPoints>337</MaxHitPoints>
      <WorkToBuild>6075</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <size>(4,1)</size>
    <costList>
      <BOR_Tenebrite>200</BOR_Tenebrite>
      <BOR_ComponentIII>1</BOR_ComponentIII>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
      <li>BOR_Research_Production_III</li>
    </researchPrerequisites>
    <designationCategory>BOR</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <WorkTableWorkSpeedFactor>0.30375</WorkTableWorkSpeedFactor>
        </statOffsets>
        <maxSimultaneous>5</maxSimultaneous>
      </li>
      <li MayRequire="hobbes.bamba.evenmorelinkables" Class="Hobbes.MoreLinkablesProduction.CompProperties_WorkHelper">
        <radius>7</radius>
        <tickInterval>2000</tickInterval>
        <reductionAmt>500</reductionAmt>
      </li>
    </comps>
    <designationHotKey>Misc6</designationHotKey>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <modExtensions>
      <li Class="BeyondOurReach.DefModExtension_UmbralOnly" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>BOR_MoisturePump_III</defName>
    <label>umbral moisture pump</label>
    <description>Very slowly equalizes moisture in nearby terrain, converting marshes or shallow water into dry ground, and soft sand into normal sand. Does not affect deep water.</description>
    <graphicData>
      <texPath>Things/Building/Misc/MoisturePump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.58, 0.35, 0.25)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>550</basePowerConsumption>
      </li>
      <li Class="CompProperties_TerrainPumpDry">
        <soundWorking>MoisturePump_Ambience</soundWorking>
        <radius>20.9</radius>
        <daysToRadius>30</daysToRadius>
      </li>
    </comps>
    <tickerType>Rare</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <fillPercent>0.15</fillPercent>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <costList>
      <BOR_Tenebrite>75</BOR_Tenebrite>
      <BOR_ComponentIII>1</BOR_ComponentIII>
    </costList>
    <specialDisplayRadius>20.9</specialDisplayRadius>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <designationCategory>Misc</designationCategory>
    <rotatable>false</rotatable>
    <researchPrerequisites>
      <li>BOR_Research_Analyzer_III</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>18</constructionSkillPrerequisite>
    <modExtensions>
      <li Class="BeyondOurReach.DefModExtension_UmbralOnly" />
    </modExtensions>
  </ThingDef>
</Defs>