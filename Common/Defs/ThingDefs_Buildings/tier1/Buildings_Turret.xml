    <ThingDef ParentName="BuildingBase">
        <defName>BOR_Turret_Defender_TI</defName>
        <label>solar defender turret</label>
        <description>An autonomous defender-pattern double-barreled turret. It fires dense solar sniper rounds at a sustained high cadence, and is fed sunsteel as ammunition.</description>
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>BOR/Things/Building/tier1/turret/base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>BOR/Things/Building/tier1/turret/turret</uiIconPath>
        <size>(2,2)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <tickerType>Normal</tickerType>
        <fillPercent>0.95</fillPercent>
        <blockWind>true</blockWind>
        <canOverlapZones>false</canOverlapZones>
        <statBases>
            <MaxHitPoints>1000</MaxHitPoints>
            <WorkToBuild>20000</WorkToBuild>
            <Flammability>0.5</Flammability>
            <Beauty>-4</Beauty>
            <ShootingAccuracyTurret>0.98</ShootingAccuracyTurret>
        </statBases>
        <costList>
            <BOR_Sunsteel>352</BOR_Sunsteel>
            <ComponentSpacer>22</ComponentSpacer>
        </costList>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>BOR_Turret_Defender_TI_Gun</turretGunDef>
            <turretTopDrawSize>2.5</turretTopDrawSize>
            <turretBurstWarmupTime>0.55</turretBurstWarmupTime>
            <turretBurstCooldownTime>1</turretBurstCooldownTime>
        </building>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>16.9</explosiveRadius>
                <explosiveDamageType>BombSuper</explosiveDamageType>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>8333</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Breakdownable" />
            <!-- Sunsteel is its ammunition: 40 shots per unit. Combat Extended swaps this for its own ammo. -->
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until reload</fuelLabel>
                <fuelGizmoLabel>Solar rounds</fuelGizmoLabel>
                <outOfFuelMessage>Needs reloading</outOfFuelMessage>
                <fuelFilter>
                    <thingDefs>
                        <li>BOR_Sunsteel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>600</fuelCapacity>
                <fuelMultiplier>40</fuelMultiplier>
                <initialFuelPercent>0</initialFuelPercent>
                <autoRefuelPercent>0.5</autoRefuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <factorByDifficulty>true</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <fuelIconPath>BOR/Things/Item/Resource/sunsteel/sunsteela</fuelIconPath>
            </li>
        </comps>
        <researchPrerequisites>
            <li>BOR_Research_DefenderTurret_I</li>
        </researchPrerequisites>
        <designationCategory>BOR</designationCategory>
        <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>BOR_Turret_Defender_TI_Gun</defName>
        <techLevel>Ultra</techLevel>
        <label>solar defender autocannon</label>
        <description>A defender-pattern autonomous double-barreled cannon assembly chambered for solar sniper ammunition.</description>
        <graphicData>
            <texPath>BOR/Things/Building/tier1/turret/turret</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <weaponTags>
            <li>TurretGun</li>
        </weaponTags>
        <statBases>
          <RoyalFavorValue>1.5</RoyalFavorValue>
            <Mass>242</Mass>
            <Flammability>0</Flammability>
            <DeteriorationRate>0</DeteriorationRate>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>BOR_Bullet_SniperRifle_TI</defaultProjectile>
                <minRange>8</minRange>
                <range>159.9</range>
                <burstShotCount>30</burstShotCount>
                <ticksBetweenBurstShots>2</ticksBetweenBurstShots>
                <consumeFuelPerShot>1</consumeFuelPerShot>
                <soundCast>Shot_SniperRifle</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
    </ThingDef>

</Defs>