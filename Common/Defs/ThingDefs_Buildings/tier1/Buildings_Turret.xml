<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ==================== Judgment-class Ship Cannon ==================== -->

    <ThingDef ParentName="BuildingBase">
        <defName>BOR_JudgmentShipCannon</defName>
        <hasInteractionCell>False</hasInteractionCell>
        <interactionCellOffset />
        <label>Judgment-class ship cannon</label>
        <description>A triple-barreled 33cm naval artillery installation ripped from the hulls of Solarite warships. This is the same gun that once reduced enemy fleets to scattered wreckage before they could close to return fire. On the ground it carries that same apocalyptic weight — three devastating shells per salvo, and a long, ominous recharge between volleys.</description>
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>BOR/Things/Item/Equipment/weaponranged/gen1/artillery/base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(6,6)</drawSize>
        </graphicData>
        <uiIconPath>BOR/Things/Item/Equipment/weaponranged/gen1/artillery/gun</uiIconPath>
        <size>(6,6)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <tickerType>Normal</tickerType>
        <fillPercent>0.99</fillPercent>
        <blockWind>true</blockWind>
        <canOverlapZones>false</canOverlapZones>
        <statBases>
            <MaxHitPoints>2000</MaxHitPoints>
            <WorkToBuild>750000</WorkToBuild>
            <Flammability>0</Flammability>
            <Beauty>-33</Beauty>
            <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
        </statBases>
        <costList>
            <BOR_Neutronium>550</BOR_Neutronium>
            <BOR_QuasarAlloy>330</BOR_QuasarAlloy>
            <BOR_ComponentII>22</BOR_ComponentII>
        </costList>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>BOR_JudgmentShipCannon_Gun</turretGunDef>
            <turretTopDrawSize>9</turretTopDrawSize>
            <turretTopOffset>(0,1.5)</turretTopOffset>
            <turretBurstWarmupTime>4.40</turretBurstWarmupTime>
            <turretBurstCooldownTime>33</turretBurstCooldownTime>
        </building>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>12.9</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>41667</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Judgment shells (Ni)</fuelLabel>
                <fuelGizmoLabel>Judgment shells (Ni)</fuelGizmoLabel>
                <fuelFilter>
                    <thingDefs>
                        <li>BOR_Shell_JudgmentShipCannon_Ni</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>9</fuelCapacity>
                <initialFuelPercent>0</initialFuelPercent>
                <autoRefuelPercent>0.5</autoRefuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>0</minimumFueledThreshold>
                <atomicFueling>false</atomicFueling>
                <fuelMultiplier>1</fuelMultiplier>
                <factorByDifficulty>false</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <outOfFuelMessage>Cannot shoot: Out of shells</outOfFuelMessage>
                <fuelIconPath>Things/Projectile/ShellHighExplosive</fuelIconPath>
            </li>
        </comps>
        <researchPrerequisites>
            <li>BOR_Research_JudgmentCannon_I</li>
        </researchPrerequisites>
        <designationCategory>BOR</designationCategory>
        <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    </ThingDef>

    <!-- ==================== Gun Assembly ==================== -->

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>BOR_JudgmentShipCannon_Gun</defName>
        <techLevel>Ultra</techLevel>
        <label>Judgment-class 33cm gun assembly</label>
        <description>The triple-barrel main gun assembly of the Judgment-class ship cannon.</description>
        <graphicData>
            <texPath>BOR/Things/Item/Equipment/weaponranged/gen1/artillery/gun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(6,6)</drawSize>
        </graphicData>
        <weaponTags>
            <li>Artillery_BaseDestroyer</li>
        </weaponTags>
        <statBases>
          <RoyalFavorValue>1.5</RoyalFavorValue>
            <DeteriorationRate>0</DeteriorationRate>
            <Mass>16500</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>BOR_Bullet_JudgmentShipCannon_Ni</defaultProjectile>
                <forcedMissRadius>4</forcedMissRadius>
                <forcedMissRadiusClassicMortars>9</forcedMissRadiusClassicMortars>
                <requireLineOfSight>false</requireLineOfSight>
                <minRange>34.9</minRange>
                <range>900</range>
                <burstShotCount>3</burstShotCount>
                <ticksBetweenBurstShots>20</ticksBetweenBurstShots>
                <soundCast>BOR_JudgmentShot</soundCast>
                <muzzleFlashScale>20</muzzleFlashScale>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
                <consumeFuelPerShot>1</consumeFuelPerShot>
            </li>
        </verbs>
    </ThingDef>

    <!-- ==================== Shell: Ni (Solarite) ==================== -->

    <ThingDef ParentName="ResourceBase">
        <defName>BOR_Shell_JudgmentShipCannon_Ni</defName>
        <techLevel>Ultra</techLevel>
        <label>Judgment shell (Ni)</label>
        <description>A 33cm Solarite-charged naval shell for the Judgment-class ship cannon. Detonates with devastating force on impact, sending Solar fragments in all directions.</description>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Projectile/ShellHighExplosive</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.0</drawSize>
        </graphicData>
        <stackLimit>25</stackLimit>
        <statBases>
          <RoyalFavorValue>0.5</RoyalFavorValue>
            <MaxHitPoints>67</MaxHitPoints>
            <Mass>33</Mass>
            <MarketValue>1875</MarketValue>
            <Flammability>1.0</Flammability>
            <DeteriorationRate>2.0</DeteriorationRate>
        </statBases>
        <tradeTags>
            <li>BOR_Tech_I</li>
        </tradeTags>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>10.5</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
                <wickTicks>
                    <min>30</min>
                    <max>60</max>
                </wickTicks>
            </li>
        </comps>
        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <effectWorking>Cook</effectWorking>
            <soundWorking>Recipe_Machining</soundWorking>
            <workAmount>111600</workAmount>
            <targetCountAdjustment>5</targetCountAdjustment>
            <workSkill>Crafting</workSkill>
            <recipeUsers>
                <li>BOR_Bench_I</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>12</Crafting>
            </skillRequirements>
            <researchPrerequisite>BOR_Research_JudgmentCannon_I</researchPrerequisite>
        </recipeMaker>
        <costList>
            <BOR_Sunsteel>220</BOR_Sunsteel>
            <BOR_QuasarAlloy>220</BOR_QuasarAlloy>
            <BOR_ComponentII>2</BOR_ComponentII>
            <BOR_Neutronium>110</BOR_Neutronium>
        </costList>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>BOR_Bullet_JudgmentShipCannon_Ni</defName>
        <label>Judgment shell (Ni) projectile</label>
        <graphicData>
            <texPath>Things/Projectile/ShellHighExplosive</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>1.7</drawSize>
        </graphicData>
        <thingClass>Projectile_Explosive</thingClass>
        <projectile>
            <damageDef>Bomb</damageDef>
            <damageAmountBase>1046</damageAmountBase>
            <speed>54</speed>
            <explosionRadius>8.75</explosionRadius>
            <flyOverhead>true</flyOverhead>
            <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
            <soundExplode>MortarBomb_Explode</soundExplode>
            <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
        </projectile>
    </ThingDef>

