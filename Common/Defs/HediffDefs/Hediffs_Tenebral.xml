<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Grows from tenebral implants, tenebrite gear and nearby tenebrite emission. Hidden while latent. -->
	<HediffDef>
		<defName>BOR_TenebralPsychosis</defName>
		<label>tenebral psychosis</label>
		<description>Tenebrite seeps into the mind. Tenebral implants hold it at a steady level; tenebrite weapons, armor and buildings make it grow, slowly, over a few days.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.6, 0.1, 0.1)</defaultLabelColor>
		<isBad>true</isBad>
		<initialSeverity>0.001</initialSeverity>
		<minSeverity>0</minSeverity>
		<maxSeverity>1</maxSeverity>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<comps>
			<li>
				<compClass>BeyondOurReach.HediffComp_PsychosisLimit</compClass>
			</li>
		</comps>
		<stages>
			<li>
				<label>latent</label>
				<becomeVisible>false</becomeVisible>
			</li>
			<li>
				<minSeverity>0.1</minSeverity>
				<label>creeping</label>
				<statOffsets>
					<MentalBreakThreshold>0.03</MentalBreakThreshold>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.4</minSeverity>
				<label>gripping</label>
				<statOffsets>
					<MentalBreakThreshold>0.06</MentalBreakThreshold>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.7</minSeverity>
				<label>consuming</label>
				<statOffsets>
					<MentalBreakThreshold>0.1</MentalBreakThreshold>
				</statOffsets>
			</li>
		</stages>
		<modExtensions>
			<li Class="BeyondOurReach.DefModExtension_TenebralPsychosis">
				<floorPerImplant>0.1</floorPerImplant>
				<gearImplantRatio>0.5</gearImplantRatio>
				<exposureGainPerDay>0.03</exposureGainPerDay>
				<decayPerDay>0.05</decayPerDay>
				<riseToFloorPerDay>0.25</riseToFloorPerDay>
				<emissionRadius>6</emissionRadius>
				<buildingEmission>1</buildingEmission>
				<floorEmission>0.1</floorEmission>
				<maxEmission>3</maxEmission>
				<resistantFactor>0.25</resistantFactor>
			</li>
		</modExtensions>
	</HediffDef>

	<!-- Hidden: counts mental breaks suffered while psychotic. -->
	<HediffDef>
		<defName>BOR_TenebralBreakCounter</defName>
		<label>tenebral breaks</label>
		<description>Hidden counter of mental breaks suffered under tenebral psychosis.</description>
		<hediffClass>BeyondOurReach.Hediff_TenebralBreaks</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<modExtensions>
			<li Class="BeyondOurReach.DefModExtension_TenebralBreaks">
				<orientisThreshold>3</orientisThreshold>
				<umbralThreshold>6</umbralThreshold>
				<crystallizeChancePerBreak>0.5</crystallizeChancePerBreak>
				<partsPerCrystallization>1</partsPerCrystallization>
				<podThreshold>0.5</podThreshold>
			</li>
		</modExtensions>
	</HediffDef>

	<!-- Hidden: counts ability rolls per ability, from crystallization through the Umbral transformations. -->
	<HediffDef>
		<defName>BOR_DarkAbilityHits</defName>
		<label>dark ability hits</label>
		<description>Hidden tally of the rolls toward each dark ability.</description>
		<hediffClass>BeyondOurReach.Hediff_DarkAbilityHits</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<modExtensions>
			<li Class="BeyondOurReach.DefModExtension_DarkAbilities">
				<abilities>
					<li>BOR_DarkWound</li>
					<li>BOR_DarkKill</li>
					<li>BOR_DarkThrall</li>
					<li>BOR_DarkBolt</li>
				</abilities>
				<hitsToLearn>3</hitsToLearn>
				<crystallizationEmptyRolls>2</crystallizationEmptyRolls>
				<umbralEmptyRolls>8</umbralEmptyRolls>
			</li>
		</modExtensions>
	</HediffDef>

	<HediffDef>
		<defName>BOR_ThrallBrainDamage</defName>
		<label>thrall brain damage</label>
		<labelNoun>thrall brain damage</labelNoun>
		<description>The will that once lived here was torn out by force, and the brain never recovered.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.6, 0.1, 0.1)</defaultLabelColor>
		<isBad>true</isBad>
		<tendable>false</tendable>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.2</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>BOR_Crystallized</defName>
		<label>crystallized</label>
		<labelNoun>a crystallized part</labelNoun>
		<description>This body part has turned to black crystal. It no longer works and cannot be removed.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.35, 0.1, 0.45)</defaultLabelColor>
		<isBad>true</isBad>
		<tendable>false</tendable>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<stages>
			<li>
				<partEfficiencyOffset>-100</partEfficiencyOffset>
			</li>
		</stages>
	</HediffDef>

</Defs>
