<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Marks an Orientis pawn, standing in for the xenotype without Biotech. Carries the Path of Light tunables. -->
	<HediffDef>
		<defName>BOR_Orientis</defName>
		<label>orientis</label>
		<description>This person turned away from the Dark Archotech and embraced the light.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.95, 0.85, 0.5)</defaultLabelColor>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<modExtensions>
			<li Class="BeyondOurReach.DefModExtension_Orientis">
				<scarHealthFraction>0.25</scarHealthFraction>
				<stripTicks>120</stripTicks>
				<glowTicks>600</glowTicks>
				<beamTicks>60</beamTicks>
			</li>
		</modExtensions>
	</HediffDef>

	<!-- From a meditation bench or mat. -->
	<!-- From the blessing bench: works like a bionic for one quadrum, on the natural part. -->
	<HediffDef>
		<defName>BOR_Blessing</defName>
		<label>blessed</label>
		<description>This body part has been enhanced by meditation. It works better than nature made it, for now.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.95, 0.85, 0.5)</defaultLabelColor>
		<isBad>false</isBad>
		<scenarioCanAdd>false</scenarioCanAdd>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>900000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<partEfficiencyOffset>2.2</partEfficiencyOffset>
			</li>
		</stages>
	</HediffDef>

	<!-- From a raised meditation shield. Severity is the share of consciousness lost, and it stops short of killing. -->
