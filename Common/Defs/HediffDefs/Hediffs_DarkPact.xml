<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Given by the red pulse a dark mirror sends out when a dark pact is broken (see openspec/specs/dark-pacts). -->
	<HediffDef>
		<defName>BOR_DarkPunishment</defName>
		<label>dark punishment</label>
		<description>A dark pact was broken, and the dark mirror lashed out at everyone its pulse reached. Every nerve burns with the Dark Archotechs' displeasure.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.85, 0.1, 0.1)</defaultLabelColor>
		<isBad>true</isBad>
		<everCurableByItem>false</everCurableByItem>
		<scenarioCanAdd>false</scenarioCanAdd>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>60000~60000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<painOffset>0.2</painOffset>
			</li>
		</stages>
	</HediffDef>
</Defs>
