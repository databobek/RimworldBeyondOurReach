<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The air bending around a Harbinger as it speeds away (CompSkyfallerDistortion). Built on core's heat-wave
       distortion, so no DLC is needed: small ripples while it rises, one big ripple as it jumps away. -->
  <FleckDef ParentName="FleckGlowDistortBackground">
    <defName>BOR_HarbingerWarpBurst</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <graphicData>
      <texPath>Things/Mote/Black</texPath>
      <shaderParameters>
        <_distortionIntensity>0.1</_distortionIntensity>
        <_brightnessMultiplier>1.0</_brightnessMultiplier>
        <_DistortionTex>/Things/Mote/MoteHellfireCannon_HeatWaveDistortion</_DistortionTex>
      </shaderParameters>
      <drawSize>(10, 10)</drawSize>
    </graphicData>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>0.9</fadeOutTime>
    <growthRate>9</growthRate>
  </FleckDef>

  <FleckDef ParentName="FleckGlowDistortBackground">
    <defName>BOR_HarbingerWarpRise</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <graphicData>
      <texPath>Things/Mote/Black</texPath>
      <shaderParameters>
        <_distortionIntensity>0.025</_distortionIntensity>
        <_brightnessMultiplier>1.0</_brightnessMultiplier>
        <_DistortionTex>/Things/Mote/MoteHellfireCannon_HeatWaveDistortion</_DistortionTex>
      </shaderParameters>
      <drawSize>(3, 3)</drawSize>
    </graphicData>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.15</solidTime>
    <fadeOutTime>0.5</fadeOutTime>
    <growthRate>2</growthRate>
  </FleckDef>
</Defs>
