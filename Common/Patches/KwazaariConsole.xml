<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- "Connect with Kwazaari" gizmo on the comm console; see openspec/specs/kwazaari-rework -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CommsConsole"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="CommsConsole"]</xpath>
          <value>
            <comps />
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="CommsConsole"]/comps</xpath>
        <value>
          <li Class="BeyondOurReach.CompProperties_KwazaariUplink" />
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
