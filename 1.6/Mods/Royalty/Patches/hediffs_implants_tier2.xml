						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="VenomFangsQuasar"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools</xpath>
							<value>
								<tools>
									<li Class="CombatExtended.ToolCE">
										<label>venom fangs</label>
										<capacities>
											<li>ToxicBite</li>
