				<xpath>Defs/PawnKindDef[@Name="BOR_BasePawn_II"]/techHediffsRequired</xpath>
				<value>
					<li>ImmunoenhancerQuasar</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[@Name="BOR_BasePawn_II"]/techHediffsRequired</xpath>
