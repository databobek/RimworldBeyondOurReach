						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="ElbowBladeQuasar"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools</xpath>
							<value>
								<tools>
									<li Class="CombatExtended.ToolCE">
										<label>blade</label>
										<capacities>
											<li>Cut</li>
										</capacities>
										<power>20</power>
										<cooldownTime>0.83</cooldownTime>
										<armorPenetrationBlunt>0.50</armorPenetrationBlunt>
										<armorPenetrationSharp>0.45</armorPenetrationSharp>
