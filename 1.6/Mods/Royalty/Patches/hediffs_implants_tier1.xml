							<value>
								<MoveSpeed>-0.67</MoveSpeed>
								<MeleeDodgeChance>-0.04</MeleeDodgeChance>
							</value>
						</li>
						<li Class="PatchOperationRemove">
							<xpath>Defs/HediffDef[defName="StoneskinGlandSolar"]/stages/li/capMods</xpath>
						</li>
					</operations>
				</match>
			</li>
		</operations>
	</Operation>
</Patch>