										<soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
										<soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
									</li>
								</tools>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="ElbowBladeSolar"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools</xpath>
							<value>
								<tools>
									<li Class="CombatExtended.ToolCE">
										<label>blade</label>
										<capacities>
											<li>Cut</li>
										</capacities>
										<power>13</power>
										<cooldownTime>1.10</cooldownTime>
										<armorPenetrationBlunt>0.33</armorPenetrationBlunt>
										<armorPenetrationSharp>0.30</armorPenetrationSharp>
										<linkedBodyPartsGroup>Blade</linkedBodyPartsGroup>
										<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
										<soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
										<soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
									</li>
								</tools>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="KneeSpikeSolar"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools</xpath>
							<value>
								<tools>
									<li Class="CombatExtended.ToolCE">
										<label>spike</label>
										<capacities>
											<li>Stab</li>
										</capacities>
										<power>18</power>
										<cooldownTime>1.10</cooldownTime>
										<armorPenetrationBlunt>0.92</armorPenetrationBlunt>
