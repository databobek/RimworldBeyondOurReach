<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- patch sequence to patch in defs while proceeding to check for CE -->
			<!-- add Royalty-dependent pawn tech hediffs after implant defs are injected -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[@Name="BOR_BasePawn"]/techHediffsRequired</xpath>
				<value>
					<li>ImmunoenhancerSolar</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[@Name="BOR_ElitePawn"]/techHediffsRequired</xpath>
				<value>
					<li>ImmunoenhancerSolar</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[@Name="BOR_ElitePawn"]/techHediffsRequired</xpath>
				<value>
					<li>ToughskinGlandSolar</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[defName="BOR_Town_Trader"]</xpath>
				<value>
					<techHediffsRequired>
						<li>PsychicReaderSolar</li>
					</techHediffsRequired>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[defName="BOR_Farmer"]</xpath>
