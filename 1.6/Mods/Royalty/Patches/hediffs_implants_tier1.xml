						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="ArmorskinGlandSolar"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
							<value>
								<ArmorRating_Sharp>2.08</ArmorRating_Sharp>
