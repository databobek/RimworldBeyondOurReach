									<li Class="CombatExtended.ToolCE">
										<label>venom talon</label>
										<capacities>
											<li>ScratchToxic</li>
										</capacities>
										<power>12</power>
										<cooldownTime>1.10</cooldownTime>
										<armorPenetrationBlunt>0.33</armorPenetrationBlunt>
										<armorPenetrationSharp>0.33</armorPenetrationSharp>
										<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
