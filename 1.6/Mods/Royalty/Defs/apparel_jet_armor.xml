      <tags>
        <li>HiTechArmor</li>
        <li>BOR_Military_I</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <forceEyesVisibleForRotations>
        <li>1</li>
        <li>2</li>
        <li>3</li>
      </forceEyesVisibleForRotations>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>HiTechArmor</li>
      <li>BOR_HiTechArmor_I</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_Biocodable" />
    </comps>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
  </ThingDef>
</Defs>