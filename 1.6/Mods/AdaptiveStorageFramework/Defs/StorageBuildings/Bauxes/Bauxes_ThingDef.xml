<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Baux Box I -->
    <ThingDef ParentName="AdaptiveStorageBase">
        <defName>BOR_BauxBoxI</defName>
        <label>Solar Container</label>
        <graphicData>
            <texPath>BOR/bauxes/t1/baux</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
            <drawRotated>false</drawRotated>
        </graphicData>
        <description>A compact adaptive storage box. The exterior changes depending on the kind of items stored inside.</description>
        <fillPercent>0.20</fillPercent>
        <uiIconPath>BOR/bauxes/t1/baux</uiIconPath>
        <uiIconScale>1</uiIconScale>
        <size>(3,3)</size>
        <rotatable>false</rotatable>
        <defaultPlacingRot>North</defaultPlacingRot>
        <researchPrerequisites>
            <li>BOR_Research_Storage_I</li>
        </researchPrerequisites>

        <statBases>
            <MaxHitPoints>10000</MaxHitPoints>
            <WorkToBuild>10000</WorkToBuild>
            <Flammability>0</Flammability>
            <Beauty>0</Beauty>
            <Mass>4</Mass>
        </statBases>

        <costList>
            <BOR_Sunsteel>30</BOR_Sunsteel>
            <ComponentSpacer>1</ComponentSpacer>
        </costList>

        <building>
            <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
            <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
            <maxItemsInCell>50</maxItemsInCell>
            <fixedStorageSettings>
                <filter>
                    <disallowNotEverStorable>true</disallowNotEverStorable>
                    <categories>
                        <li>Foods</li>
                        <li>Medicine</li>
                        <li>Weapons</li>
                        <li>ResourcesRaw</li>
                        <li>Manufactured</li>
                    </categories>
                </filter>
            </fixedStorageSettings>
            <paintable>true</paintable>
        </building>

        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsFurniture</li>
        </thingCategories>
    </ThingDef>

