			<!-- ==============================================================
                     SECTION 8 – Rabies: patch Tenebral Bio
                     ============================================================== -->
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[defName="Vaccine_Rabies"]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="BOR_TenebralVaccine_Bio"]/ingestible/outcomeDoers</xpath>
					<value>
						<li Class="IngestionOutcomeDoer_GiveHediff">
							<hediffDef>ArchoVaccinated_Rabies</hediffDef>
							<severity>1.0</severity>
						</li>
						<li Class="IngestionOutcomeDoer_GiveHediff">
							<hediffDef>ArchoVaccinated_RabiesActive</hediffDef>
							<severity>1.0</severity>
						</li>
					</value>
				</match>
			</li>
			<!-- ==============================================================
                     SECTION 9 – Anomaly DLC: patch Tenebral Mech I with
                                 MetalhorrorImplant jailbreak
                     ============================================================== -->
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThingDef[defName="NanoVaccine_MetalhorrorImplant"]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="BOR_TenebralVaccine_Mech_I"]/ingestible/outcomeDoers</xpath>
					<value>
						<li Class="MedicalExpansionVaccines.IngestionOutcomeDoer_MechaniteJailbreak">
							<watcherHediffDef>NanoShieldWatcher_MetalhorrorImplant</watcherHediffDef>
						</li>
					</value>
				</match>
			</li>
		</operations>
	</Operation>
</Patch>