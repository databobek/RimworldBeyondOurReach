<Patch>

    <Operation Class="BeyondOurReachModSettings.PatchOperationModSettings">
        <modSettingDef>BOR_Setting_CE_TODO</modSettingDef>
        <enabled Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>

                <ThingDef ParentName="BaseBulletCE">
                    <defName>BOR_Bullet_Gen2Rifle_QaP</defName>
                    <label>Gen II 20.5×95mm QA rifle bullet (QaP)</label>
				<graphicData>
					<texPath>Things/Projectile/Bullet_Small</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>

                    <projectile Class="CombatExtended.ProjectilePropertiesCE">
                        <damageDef>Bullet</damageDef>
                        <damageAmountBase>24</damageAmountBase>
                        <armorPenetrationSharp>82</armorPenetrationSharp>
                        <armorPenetrationBlunt>150</armorPenetrationBlunt>
                        <speed>250</speed>
                    </projectile>
                </ThingDef>

                <ThingDef ParentName="BaseBulletCE">
                    <defName>BOR_Bullet_Gen2Rifle_Nc</defName>
                    <label>Gen II 20.5×95mm QA rifle bullet (Nc)</label>
				<graphicData>
					<texPath>Things/Projectile/Bullet_Small</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>

                    <projectile Class="CombatExtended.ProjectilePropertiesCE">
                        <damageDef>Bullet</damageDef>
                        <damageAmountBase>25</damageAmountBase>
                        <armorPenetrationSharp>65</armorPenetrationSharp>
                        <armorPenetrationBlunt>165</armorPenetrationBlunt>
                        <speed>250</speed>
                        <secondaryDamage>
                            <li>
                                <def>Flame_Secondary</def>
                                <amount>5</amount>
                            </li>
                        </secondaryDamage>
                    </projectile>
                </ThingDef>

                <ThingDef ParentName="BaseBulletCE">
                    <defName>BOR_Bullet_Gen2Rifle_Ni</defName>
                    <label>Gen II 20.5×95mm QA rifle bullet (Ni)</label>
				<graphicData>
					<texPath>Things/Projectile/Bullet_Small</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>

                    <projectile Class="CombatExtended.ProjectilePropertiesCE">
                        <damageDef>Bullet</damageDef>
                        <damageAmountBase>32</damageAmountBase>
                        <armorPenetrationSharp>55</armorPenetrationSharp>
                        <armorPenetrationBlunt>185</armorPenetrationBlunt>
                        <speed>220</speed>
                        <secondaryDamage>
                            <li>
                                <def>Bomb_Secondary</def>
                                <amount>12</amount>
                            </li>
                        </secondaryDamage>
                    </projectile>
                </ThingDef>

                <ThingDef ParentName="BaseBulletCE">
                    <defName>BOR_Bullet_Gen2Rifle_TC</defName>
                    <label>Gen II 20.5×95mm QA rifle bullet (TC)</label>
				<graphicData>
					<texPath>Things/Projectile/Bullet_Small</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>

                    <projectile Class="CombatExtended.ProjectilePropertiesCE">
                        <damageDef>Bullet</damageDef>
                        <damageAmountBase>19</damageAmountBase>
                        <armorPenetrationSharp>118</armorPenetrationSharp>
                        <armorPenetrationBlunt>280</armorPenetrationBlunt>
                        <speed>300</speed>
                    </projectile>
                </ThingDef>

            </value>
        </enabled>
    </Operation>
    
</Patch>