<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- ========== Judgment-class Ship Cannon - CE Integration (Mortar-style rebuild) ========== -->

    <!-- 1. Use CE turret class -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon"]/thingClass</xpath>
        <value>
            <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
        </value>
    </Operation>

    <!-- 2. Remove vanilla refueling and explosive comps -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon"]/comps/li[@Class="CompProperties_Refuelable"]</xpath>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
    </Operation>

    <!-- 3. Remove vanilla shells and projectiles replaced below with CE defs -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[
            defName="BOR_Shell_JudgmentShipCannon_Ni" or
            defName="BOR_Shell_JudgmentShipCannon_Ef" or
            defName="BOR_Bullet_JudgmentShipCannon_Ni" or
            defName="BOR_Bullet_JudgmentShipCannon_Ef"
            ]</xpath>
    </Operation>

    <!-- 4. Convert gun to CE mortar-style weapon -->
    <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>BOR_JudgmentShipCannon_Gun</defName>
        <statBases>
            <RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
            <SightsEfficiency>1.2</SightsEfficiency>
            <ShotSpread>0.01</ShotSpread>
            <SwayFactor>0.05</SwayFactor>
        </statBases>
        <Properties>
            <recoilAmount>0.8</recoilAmount>
            <verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
            <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
            <hasStandardCommand>true</hasStandardCommand>
            <defaultProjectile>BOR_Bullet_JudgmentShipCannon_Ni_CE</defaultProjectile>
            <warmupTime>6.5</warmupTime>
            <range>700</range>
            <minRange>32</minRange>
            <ticksBetweenBurstShots>20</ticksBetweenBurstShots>
            <requireLineOfSight>false</requireLineOfSight>
            <burstShotCount>3</burstShotCount>
            <soundCast>Mortar_LaunchA</soundCast>
            <muzzleFlashScale>16</muzzleFlashScale>
            <circularError>0.45</circularError>
            <indirectFirePenalty>0.12</indirectFirePenalty>
            <recoilPattern>Mounted</recoilPattern>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
            </targetParams>
            <onlyManualCast>true</onlyManualCast>
        </Properties>
        <AmmoUser>
            <magazineSize>3</magazineSize>
            <reloadTime>90</reloadTime>
            <ammoSet>AmmoSet_BOR_JudgmentShell</ammoSet>
        </AmmoUser>
        <weaponTags>
            <li>TurretGun</li>
        </weaponTags>
    </Operation>

    <!-- 5. Preserve triple-barrel behavior -->
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon_Gun"]</xpath>
        <value>
            <li Class="CombatExtended.MultiBarrelExtension">
                <offsets>
                    <li>(-0.5,1)</li>
                    <li>(0,1)</li>
                    <li>(0.5,1)</li>
                </offsets>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon_Gun"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon_Gun"]</xpath>
            <value>
                <comps />
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon_Gun"]/comps</xpath>
        <value>
            <li Class="CombatExtended.CompProperties_Charges">
                <chargeSpeeds>
                    <li>90</li>
                    <li>130</li>
                    <li>170</li>
                </chargeSpeeds>
            </li>
        </value>
    </Operation>

    <!-- 6. Slow heavy-turret rotation -->
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon"]</xpath>
        <value>
            <li Class="CombatExtended.NonSnapTurretExtension">
                <speed>0.3</speed>
            </li>
        </value>
    </Operation>

    <!-- 7. CE aiming stat -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BOR_JudgmentShipCannon"]/statBases</xpath>
        <value>
            <AimingAccuracy>1.0</AimingAccuracy>
        </value>
    </Operation>

