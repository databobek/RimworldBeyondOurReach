	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>BOR_Gun_QuasarLaserRifle_TII</defName>
		<label>kwazaari less-lethal beam rifle</label>
		<description>A standard-issue kwazaari beam rifle retuned for less-than-lethal crowd control and detainment operations. Its emitter trades armor-piercing output for a disabling stun, neuralizer, or electromagnetic discharge, incapacitating hostiles without lethal harm.</description>
		<graphicData>
			<texPath>BOR/Things/Item/Equipment/weaponranged/gen2/plazma/rifle-plas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.1</drawSize>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<thingCategories>
			<li>BOR_Weapons_II</li>
		</thingCategories>
		<statBases>
			<WorkToMake>90000</WorkToMake>
			<Mass>3.85</Mass>
			<Bulk>11.55</Bulk>
			<SwayFactor>1.49</SwayFactor>
			<ShotSpread>0.09</ShotSpread>
			<SightsEfficiency>0.92</SightsEfficiency>
			<RangedWeapon_Cooldown>0.33</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>SpacerGun</li>
			<li>Laser</li>
			<li>CE_AI_AR</li>
		</weaponTags>
		<verbs Inherit="False">
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<soundAiming>Laser_Warmup</soundAiming>
				<defaultProjectile>BOR_XCOM_Bullet_QuasarLaserRifle_Stun</defaultProjectile>
				<warmupTime>0.92</warmupTime>
				<range>29.88</range>
				<soundCast>Shot_ChargeRifle</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
