<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="BeyondOurReachModSettings.PatchOperationModSettings">
		<modSettingDef>BOR_Setting_DubsBadHygiene</modSettingDef>
		<enabled Class="PatchOperationSequence">
			<operations>

				<!-- patch sequence to patch in defs while proceeding to check for pawnkinds to be updated -->
				<li Class="PatchOperationAdd">
					<xpath>Defs</xpath>

					<value>

						<HediffDef ParentName="BOR_ImplantQuasarHediffBase">
							<defaultLabelColor>(106, 123, 206)</defaultLabelColor>
							<defName>QuasarBladder</defName>
							<label>kwazaari hygiene recycler</label>
							<labelNoun>a kwazaari hygiene recycler</labelNoun>
							<description>An installed kwazaari hygiene recycler.</description>
							<descriptionHyperlinks>
								<ThingDef>QuasarBladder</ThingDef>
							</descriptionHyperlinks>
							<spawnThingOnRemoved>QuasarBladder</spawnThingOnRemoved>
							<stages>
								<li>
									<statOffsets>
										<BladderRateMultiplier>-0.675</BladderRateMultiplier>
										<ThirstRateMultiplier>-0.675</ThirstRateMultiplier>
										<HygieneRateMultiplier>-0.675</HygieneRateMultiplier>
									</statOffsets>
								</li>
							</stages>
						</HediffDef>

						<ThingDef ParentName="BodyPartBionicBase">
							<defName>QuasarBladder</defName>
							<label>kwazaari hygiene recycler</label>
							<description>An advanced kwazaari-tech hygiene recycler. A chemical recycling system breaks down waste products while mechanites reduce skin and hair detritus, with the downside of occasional gas.</description>
							<descriptionHyperlinks>
								<RecipeDef>InstallQuasarBladder</RecipeDef>
							</descriptionHyperlinks>
							<costList>
								<BOR_QuasarAlloy>11</BOR_QuasarAlloy>
								<BOR_ComponentII>4</BOR_ComponentII>
							</costList>
							<thingCategories Inherit="False">
								<li>BOR_Bionics_II</li>
							</thingCategories>
							<statBases>
								<Mass>2</Mass>
								<WorkToMake>20000</WorkToMake>
								<MarketValue>22000</MarketValue>

								<RoyalFavorValue>1</RoyalFavorValue>
							</statBases>
							<recipeMaker>
								<skillRequirements>
									<Crafting>16</Crafting>
								</skillRequirements>
								<researchPrerequisite MayRequire="dbhlitemode">HygieneBionics</researchPrerequisite>
								<recipeUsers Inherit="False">
									<li>BOR_MedicineBench_II</li>
								</recipeUsers>
							</recipeMaker>
							<graphicData>
								<texPath>Things/Item/Health/HealthItem</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>0.80</drawSize>
							</graphicData>
							<tradeTags>
								<li>BOR_Tech_II</li>
							</tradeTags>
						</ThingDef>

						<RecipeDef ParentName="SurgeryInstallImplantBase">
							<defName>InstallQuasarBladder</defName>
							<label>install kwazaari hygiene recycler</label>
							<description>Install a kwazaari hygiene recycler.</description>
							<skillRequirements>
								<Medicine>16</Medicine>
							</skillRequirements>
							<descriptionHyperlinks>
								<ThingDef>QuasarBladder</ThingDef>
								<HediffDef>QuasarBladder</HediffDef>
							</descriptionHyperlinks>
							<jobString>Installing kwazaari hygiene recycler.</jobString>
							<ingredients>
								<li>
									<filter>
										<thingDefs>
											<li>QuasarBladder</li>
										</thingDefs>
									</filter>
									<count>1</count>
								</li>
								<li>
									<filter>
										<thingDefs>
											<li>BOR_MedicineII</li>
										</thingDefs>
									</filter>
									<count>4</count>
								</li>
								<li>
									<filter>
										<thingDefs>
											<li>BOR_Picoclusters</li>
										</thingDefs>
									</filter>
									<count>1</count>
								</li>
							</ingredients>
							<fixedIngredientFilter>
								<thingDefs>
									<li>BOR_MedicineII</li>
									<li>BOR_Picoclusters</li>
									<li>QuasarBladder</li>
								</thingDefs>
							</fixedIngredientFilter>
							<addsHediff>QuasarBladder</addsHediff>
							<appliedOnFixedBodyParts>
								<li>Torso</li>
							</appliedOnFixedBodyParts>
						</RecipeDef>

					</value>
				</li>

				<!-- update pawnkinds techhediffs after the defs are loaded in -->
				<li Class="PatchOperationSequence">
					<operations>

						<li Class="PatchOperationAdd">
							<xpath>Defs/PawnKindDef[@Name="BOR_BasePawn_II"
								or @Name="BOR_ElitePawn_II"]/techHediffsRequired
							</xpath>
							<value>
								<li MayRequire="dubwise.dubsbadhygiene">QuasarBladder</li>
							</value>
						</li>

					</operations>
				</li>
			</operations>
		</enabled>
	</Operation>

</Patch>