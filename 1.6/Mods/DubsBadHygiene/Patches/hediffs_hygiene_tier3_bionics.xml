<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="BeyondOurReachModSettings.PatchOperationModSettings">
		<modSettingDef>BOR_Setting_DubsBadHygiene</modSettingDef>
		<enabled Class="PatchOperationSequence">
			<operations>

				<!-- patch sequence to patch in defs while proceeding to check for pawnkinds to be updated -->
				<li Class="PatchOperationAdd">
					<xpath>Defs</xpath>

					<value>

						<HediffDef ParentName="BOR_ImplantTenebralHediffBase">
							<defaultLabelColor>(128, 0, 0)</defaultLabelColor>
							<defName>TenebralBladder</defName>
							<label>tenebral hygiene recycler</label>
							<labelNoun>a tenebral hygiene recycler</labelNoun>
							<description>An installed tenebral hygiene recycler.</description>
							<descriptionHyperlinks>
								<ThingDef>TenebralBladder</ThingDef>
							</descriptionHyperlinks>
							<spawnThingOnRemoved>TenebralBladder</spawnThingOnRemoved>
							<stages>
								<li>
									<statOffsets>
										<BladderRateMultiplier>-0.765</BladderRateMultiplier>
										<ThirstRateMultiplier>-0.765</ThirstRateMultiplier>
										<HygieneRateMultiplier>-0.765</HygieneRateMultiplier>
									</statOffsets>
									<painOffset>0.05</painOffset>
								</li>
							</stages>
						</HediffDef>

						<ThingDef ParentName="BodyPartBionicBase">
							<defName>TenebralBladder</defName>
							<label>tenebral hygiene recycler</label>
							<description>An advanced tenebral-tech hygiene recycler. A chemical recycling system breaks down waste products while mechanites reduce skin and hair detritus, with the downside of occasional gas.</description>
							<descriptionHyperlinks>
								<RecipeDef>InstallTenebralBladder</RecipeDef>
							</descriptionHyperlinks>
							<costList>
								<BOR_Tenebrite>11</BOR_Tenebrite>
								<BOR_ComponentIII>1</BOR_ComponentIII>
							</costList>
							<thingCategories Inherit="False">
								<li>BOR_Bionics_III</li>
							</thingCategories>
							<statBases>
								<Mass>2</Mass>
								<WorkToMake>30000</WorkToMake>
								<MarketValue>33000</MarketValue>

								<RoyalFavorValue>2</RoyalFavorValue>
							</statBases>
							<recipeMaker>
								<skillRequirements>
									<Crafting>18</Crafting>
								</skillRequirements>
								<researchPrerequisite MayRequire="dbhlitemode">HygieneBionics</researchPrerequisite>
								<recipeUsers Inherit="False">
									<li>BOR_MedicineBench_III</li>
									<li>BOR_Bench_IV</li>
								</recipeUsers>
							</recipeMaker>
							<graphicData>
								<texPath>Things/Item/Health/HealthItem</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>0.80</drawSize>
								<color>(69, 32, 41)</color>
							</graphicData>
							<tradeTags>
								<li>BOR_Tech_III</li>
							</tradeTags>
						</ThingDef>

						<RecipeDef ParentName="SurgeryInstallImplantBase">
							<defName>InstallTenebralBladder</defName>
							<label>install tenebral hygiene recycler</label>
							<description>Install a tenebral hygiene recycler.</description>
							<skillRequirements>
								<Medicine>18</Medicine>
							</skillRequirements>
							<descriptionHyperlinks>
								<ThingDef>TenebralBladder</ThingDef>
								<HediffDef>TenebralBladder</HediffDef>
							</descriptionHyperlinks>
							<jobString>Installing tenebral hygiene recycler.</jobString>
							<ingredients>
								<li>
									<filter>
										<thingDefs>
											<li>TenebralBladder</li>
										</thingDefs>
									</filter>
									<count>1</count>
								</li>
								<li>
									<filter>
										<thingDefs>
											<li>BOR_MedicineIII</li>
										</thingDefs>
									</filter>
									<count>4</count>
								</li>
								<li>
									<filter>
										<thingDefs>
											<li>BOR_Femtoclusters</li>
										</thingDefs>
									</filter>
									<count>1</count>
								</li>
							</ingredients>
							<fixedIngredientFilter>
								<thingDefs>
									<li>BOR_MedicineIII</li>
									<li>BOR_Femtoclusters</li>
									<li>TenebralBladder</li>
								</thingDefs>
							</fixedIngredientFilter>
							<addsHediff>TenebralBladder</addsHediff>
							<appliedOnFixedBodyParts>
								<li>Torso</li>
							</appliedOnFixedBodyParts>
						</RecipeDef>

					</value>
				</li>

				<!-- update pawnkinds techhediffs after the defs are loaded in -->
				<li Class="PatchOperationSequence">
					<operations>

						<!-- placeholder, in case you decide to ever add a tier 3 pawn with this implant
					<li Class="PatchOperationAdd">
					  <xpath>Defs/PawnKindDef[@Name="BOR_BasePawn_III" 
												or @Name="BOR_ElitePawn_III"]/techHediffsRequired
					  </xpath>
					  <value>
						<li MayRequire="dubwise.dubsbadhygiene">TenebralBladder</li>
					  </value>
					</li>
					-->

					</operations>
				</li>
			</operations>
		</enabled>
	</Operation>

</Patch>