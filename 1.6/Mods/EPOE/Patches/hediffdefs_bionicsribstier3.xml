<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="BeyondOurReachModSettings.PatchOperationModSettings">
		<modSettingDef>BOR_Setting_EPOE</modSettingDef>
		<enabled Class="PatchOperationSequence">
			<operations>

				<!-- patch sequence to patch in defs while proceeding to check for pawnkinds to be updated -->
				<li Class="PatchOperationAdd">
					<xpath>Defs</xpath>

					<value>

						<ThingDef Name="EPIA_BodyPartBionicRibBaseBBORTenebral" ParentName="EPIASyntheticBase" Abstract="True">
							<recipeMaker>
								<soundWorking>Recipe_Smith</soundWorking>
								<recipeUsers Inherit="False">
									<li>BOR_MedicineBench_III</li>
									<li>BOR_Bench_IV</li>
								</recipeUsers>
								<researchPrerequisite>BOR_Research_Bionics_III</researchPrerequisite>
								<skillRequirements>
									<Crafting>19</Crafting>
								</skillRequirements>
							</recipeMaker>
							<statBases>
								<WorkToMake>30000</WorkToMake>
								<MarketValue>45000</MarketValue>

								<RoyalFavorValue>2</RoyalFavorValue>
							</statBases>
							<graphicData>
								<texPath>Things/Item/Health/HealthItem</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>0.80</drawSize>
								<color>(69, 32, 41)</color>
							</graphicData>
							<thingCategories Inherit="False">
								<li>BOR_Bionics_III</li>
							</thingCategories>
							<tradeTags Inherit="False">
								<li>BOR_Bionics_III</li>
								<li>BOR_Tech_III</li>
							</tradeTags>
						</ThingDef>

						<RecipeDef ParentName="SurgeryInstallImplantBase" Name="SurgeryInstallImplantBaseBBORTenebral" Abstract="True">
							<recipeUsers>
								<li>Human</li>
							</recipeUsers>
							<skillRequirements>
								<Medicine>19</Medicine>
							</skillRequirements>
							<ingredients Inherit="False">
								<li>
									<filter>
										<thingDefs>
											<li>BOR_MedicineIII</li>
										</thingDefs>
									</filter>
									<count>3</count>
								</li>
								<li>
									<filter>
										<thingDefs>
											<li>BOR_Femtoclusters</li>
										</thingDefs>
									</filter>
									<count>1</count>
								</li>
							</ingredients>
							<fixedIngredientFilter Inherit="False">
								<thingDefs>
									<li>BOR_MedicineIII</li>
									<li>BOR_Femtoclusters</li>
								</thingDefs>
							</fixedIngredientFilter>
						</RecipeDef>

						<HediffDef ParentName="addedPartBionicsRib" Abstract="True" Name="BOR_addedPartBionicsTenebralRib">
							<defaultLabelColor>(128, 0, 0)</defaultLabelColor>
							<comps>
								<li MayRequire="v1024.ebframework" Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust">
									<scaleAdjustment>3.375</scaleAdjustment>
								</li>
							</comps>
						</HediffDef>

						<!-- Chemoregulator rib (1+2+3+9, 4 omitted) -->

						<HediffDef ParentName="BOR_addedPartBionicsTenebralRib">
							<defaultLabelColor>(128, 0, 0)</defaultLabelColor>
							<defName>ChemoregulatorRibTenebral</defName>
							<label>tenebral chemoregulator rib</label>
							<labelNoun>a tenebral chemoregulator rib</labelNoun>
							<description>An installed tenebral chemoregulator rib implant.</description>
							<descriptionHyperlinks>
								<ThingDef>ChemoregulatorRibTenebral</ThingDef>
							</descriptionHyperlinks>
							<spawnThingOnRemoved>ChemoregulatorRibTenebral</spawnThingOnRemoved>
							<hediffClass>Hediff_Implant</hediffClass>
							<stages>
								<li>
									<painOffset>0.025</painOffset>
									<restFallFactor>0.595</restFallFactor>
									<statOffsets>
										<MentalBreakThreshold>0.135</MentalBreakThreshold>
									</statOffsets>
									<capMods>
										<li>
											<capacity>BloodFiltration</capacity>
											<offset>0.405</offset>
										</li>
										<li>
											<capacity>Consciousness</capacity>
											<offset>0.045</offset>
										</li>
										<li>
											<capacity>Moving</capacity>
											<offset>0.405</offset>
										</li>
									</capMods>
								</li>
							</stages>
							<tags>
								<li>ChemoregulatorRib</li>
							</tags>
						</HediffDef>

						<ThingDef ParentName="EPIA_BodyPartBionicRibBaseBBORTenebral">
							<defName>ChemoregulatorRibTenebral</defName>
							<label>tenebral chemoregulator rib implant</label>
							<description>An artificial tenebral rib that combines medical filtration, stimulant control, and chem distribution systems.</description>
							<descriptionHyperlinks>
								<RecipeDef>InstallChemoregulatorRibTenebral</RecipeDef>
							</descriptionHyperlinks>
							<costList>
								<BOR_Tenebrite>36</BOR_Tenebrite>
								<BOR_ComponentIII>1</BOR_ComponentIII>
								<Neutroamine>10</Neutroamine>
								<BOR_Pax>9</BOR_Pax>
								<BOR_Crewmates>18</BOR_Crewmates>
								<BOR_Gallop>4</BOR_Gallop>
								<BOR_Adreamoline>4</BOR_Adreamoline>
							</costList>
							<statBases>
								<Mass>1.35</Mass>
								<RoyalFavorValue>2</RoyalFavorValue>
							</statBases>
						</ThingDef>

						<RecipeDef ParentName="SurgeryInstallImplantBaseBBORTenebral">
							<defName>InstallChemoregulatorRibTenebral</defName>
							<label>install tenebral chemoregulator rib implant</label>
							<description>Installs a tenebral chemoregulator rib implant.</description>
							<descriptionHyperlinks>
								<ThingDef>ChemoregulatorRibTenebral</ThingDef>
								<HediffDef>ChemoregulatorRibTenebral</HediffDef>
							</descriptionHyperlinks>
							<jobString>Installing a tenebral chemoregulator rib.</jobString>
							<ingredients>
								<li>
									<filter>
										<thingDefs>
											<li>ChemoregulatorRibTenebral</li>
										</thingDefs>
									</filter>
									<count>1</count>
								</li>
							</ingredients>
							<fixedIngredientFilter>
								<thingDefs>
									<li>ChemoregulatorRibTenebral</li>
								</thingDefs>
							</fixedIngredientFilter>
							<appliedOnFixedBodyParts>
								<li>Ribcage</li>
							</appliedOnFixedBodyParts>
							<addsHediff>ChemoregulatorRibTenebral</addsHediff>
							<uiIconThing>ChemoregulatorRibTenebral</uiIconThing>
							<incompatibleWithHediffTags>
								<li>ChemoregulatorRib</li>
								<li>LuciferiumRib</li>
							</incompatibleWithHediffTags>
						</RecipeDef>

						<RecipeDef ParentName="SurgeryRemoveImplantBase">
							<defName>RemoveChemoregulatorRibTenebral</defName>
							<label>remove tenebral chemoregulator rib implant</label>
							<description>Remove a tenebral chemoregulator rib implant.</description>
							<descriptionHyperlinks>
								<ThingDef>ChemoregulatorRibTenebral</ThingDef>
								<HediffDef>ChemoregulatorRibTenebral</HediffDef>
							</descriptionHyperlinks>
							<jobString>Removing tenebral rib implant.</jobString>
							<removesHediff>ChemoregulatorRibTenebral</removesHediff>
						</RecipeDef>

						<!-- Mecharegulator rib (5+6+7+8) -->

						<HediffDef ParentName="BOR_addedPartBionicsTenebralRib">
							<defaultLabelColor>(128, 0, 0)</defaultLabelColor>
							<defName>MecharegulatorRibTenebral</defName>
							<label>tenebral mecharegulator rib</label>
							<labelNoun>a tenebral mecharegulator rib</labelNoun>
							<description>An installed tenebral mecharegulator rib implant.</description>
							<descriptionHyperlinks>
								<ThingDef>MecharegulatorRibTenebral</ThingDef>
							</descriptionHyperlinks>
							<spawnThingOnRemoved>MecharegulatorRibTenebral</spawnThingOnRemoved>
							<hediffClass>Hediff_Implant</hediffClass>
							<stages>
								<li>
									<painOffset>0.025</painOffset>
									<totalBleedFactor>0.495</totalBleedFactor>
									<statOffsets>
										<ComfyTemperatureMax>36</ComfyTemperatureMax>
										<ComfyTemperatureMin>-36</ComfyTemperatureMin>
										<MentalBreakThreshold>-0.27</MentalBreakThreshold>
									</statOffsets>
									<capMods>
										<li>
											<capacity>Breathing</capacity>
											<offset>0.405</offset>
										</li>
									</capMods>
								</li>
							</stages>
							<tags>
								<li>MecharegulatorRib</li>
							</tags>
						</HediffDef>

						<ThingDef ParentName="EPIA_BodyPartBionicRibBaseBBORTenebral">
							<defName>MecharegulatorRibTenebral</defName>
							<label>tenebral mecharegulator rib implant</label>
							<description>An artificial tenebral rib with thermal control, coagulation, and respiratory support systems.</description>
							<descriptionHyperlinks>
								<RecipeDef>InstallMecharegulatorRibTenebral</RecipeDef>
							</descriptionHyperlinks>
							<costList>
								<BOR_Tenebrite>45</BOR_Tenebrite>
								<BOR_Sunsteel>18</BOR_Sunsteel>
								<BOR_ComponentIII>1</BOR_ComponentIII>
								<Neutroamine>2</Neutroamine>
								<BOR_MedicineIII>4</BOR_MedicineIII>
							</costList>
							<statBases>
								<Mass>1.35</Mass>
								<RoyalFavorValue>2</RoyalFavorValue>
							</statBases>
						</ThingDef>

						<RecipeDef ParentName="SurgeryInstallImplantBaseBBORTenebral">
							<defName>InstallMecharegulatorRibTenebral</defName>
							<label>install tenebral mecharegulator rib implant</label>
							<description>Installs a tenebral mecharegulator rib implant.</description>
							<descriptionHyperlinks>
								<ThingDef>MecharegulatorRibTenebral</ThingDef>
								<HediffDef>MecharegulatorRibTenebral</HediffDef>
							</descriptionHyperlinks>
							<jobString>Installing a tenebral mecharegulator rib.</jobString>
							<ingredients>
								<li>
									<filter>
										<thingDefs>
											<li>MecharegulatorRibTenebral</li>
										</thingDefs>
									</filter>
									<count>1</count>
								</li>
							</ingredients>
							<fixedIngredientFilter>
								<thingDefs>
									<li>MecharegulatorRibTenebral</li>
								</thingDefs>
							</fixedIngredientFilter>
							<appliedOnFixedBodyParts>
								<li>Ribcage</li>
							</appliedOnFixedBodyParts>
							<addsHediff>MecharegulatorRibTenebral</addsHediff>
							<uiIconThing>MecharegulatorRibTenebral</uiIconThing>
							<incompatibleWithHediffTags>
								<li>MecharegulatorRib</li>
								<li>LuciferiumRib</li>
							</incompatibleWithHediffTags>
						</RecipeDef>

						<RecipeDef ParentName="SurgeryRemoveImplantBase">
							<defName>RemoveMecharegulatorRibTenebral</defName>
							<label>remove tenebral mecharegulator rib implant</label>
							<description>Remove a tenebral mecharegulator rib implant.</description>
							<descriptionHyperlinks>
								<ThingDef>MecharegulatorRibTenebral</ThingDef>
								<HediffDef>MecharegulatorRibTenebral</HediffDef>
							</descriptionHyperlinks>
							<jobString>Removing tenebral rib implant.</jobString>
							<removesHediff>MecharegulatorRibTenebral</removesHediff>
						</RecipeDef>

					</value>
				</li>

				<!-- update pawnkinds techhediffs after the defs are loaded in -->
				<li Class="PatchOperationSequence">
					<operations>

						<!-- just a placeholder for future sequence related patches -->

					</operations>
				</li>
			</operations>
		</enabled>
	</Operation>

</Patch>
