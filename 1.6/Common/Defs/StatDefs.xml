<Defs>

  <!-- Quantum Forging: Transmuting Neutronium into various materials and goods -->
  <!-- Requires manipulation, consciousness for mental control, sight for precision work, and crafting/intellectual knowledge -->
  <StatDef>
    <defName>BOR_QuantumForging</defName>
    <label>quantum forging speed</label>
    <description>The speed at which this character can forge Neutronium into various materials and goods using a Sunforge. This complex process demands steady manipulation for precise quantum state transitions, mental consciousness to maintain the quantum coherence field, keen sight to monitor the transmutation process, and deep knowledge of crafting and science to convert atoms into specific materials.</description>
    <category>PawnWork</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <statFactors>
      <li>WorkSpeedGlobal</li>
    </statFactors>
    <skillNeedFactors>
      <li Class="SkillNeed_BaseBonus">
        <skill>Crafting</skill>
        <baseValue>0.15</baseValue>
        <bonusPerLevel>0.08</bonusPerLevel>
      </li>
      <li Class="SkillNeed_BaseBonus">
        <skill>Intellectual</skill>
        <baseValue>0.1</baseValue>
        <bonusPerLevel>0.06</bonusPerLevel>
      </li>
    </skillNeedFactors>
    <capacityFactors>
      <li>
        <capacity>Manipulation</capacity>
        <weight>1</weight>
        <max>2.25</max>
      </li>
      <li>
        <capacity>Consciousness</capacity>
        <weight>1</weight>
        <max>2.25</max>
      </li>
      <li>
        <capacity>Sight</capacity>
        <weight>0.8</weight>
        <max>2.25</max>
      </li>
    </capacityFactors>
    <displayPriorityInCategory>4551</displayPriorityInCategory>
    <supressDisabledError>true</supressDisabledError>
  </StatDef>

