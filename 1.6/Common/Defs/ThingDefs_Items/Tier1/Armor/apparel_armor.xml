  <ThingDef ParentName="ArmorMachineableBase">
    <defName>BOR_Solar_Apparel_FlakVest</defName>
    <label>solar flak vest</label>
    <description>A molded sunsteel plate fashioned to protect the torso. Conventional weaponry may do little but scratch the material, but it does nothing to protect your limbs.</description>
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
        <li>FlakArmor</li>
      </researchPrerequisites>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>220</displayPriority>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
    </recipeMaker>
    <graphicData>
      <color>(0.36, 0.62, 0.68)</color>
      <texPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.90</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>13500</WorkToMake>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>3</Mass>
      <Flammability>0.5</Flammability>
      <ArmorRating_Sharp>1.25</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
      <ArmorRating_Heat>0.35</ArmorRating_Heat>
      <Insulation_Cold>2</Insulation_Cold>
      <EquipDelay>6</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.50</ToxicEnvironmentResistance>
      <MoveSpeed>-0.09</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_I</li>
    </thingCategories>
    <costList>
      <BOR_Sunweave>33</BOR_Sunweave>
      <BOR_Sunsteel>66</BOR_Sunsteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>HiTechArmor</li>
        <li>BOR_Military_I</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_I</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
  </ThingDef>

