<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="BOR_QualityHeadgearBase" ParentName="ArmorHelmetMakeableBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef Name="BOR_QualityArmorBase" ParentName="ArmorMachineableBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef Name="BOR_NoQualityWearableBase" ParentName="ApparelNoQualityBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
  </ThingDef>

  <!-- Headgear -->

  <ThingDef ParentName="BOR_QualityHeadgearBase">
    <defName>BOR_QuantumRebreatherMask</defName>
    <label>quantum rebreather mask</label>
    <description>A filtered quantum rebreather built for hazardous substrate work. The mask stabilizes breathing feedback and keeps the wearer steady in environments where fine pressure control matters more than raw armor.</description>
    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/QuantumRebreather/quantum_rebreather</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.90</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>31500</WorkToMake>
      <MaxHitPoints>188</MaxHitPoints>
      <Mass>1.10</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.17</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
      <ArmorRating_Heat>0.54</ArmorRating_Heat>
      <Insulation_Cold>3</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <BOR_Synthesize_Neutronium>0.10</BOR_Synthesize_Neutronium>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_Headgear_I</li>
    </thingCategories>
    <costList>
      <BOR_Sunsteel>38</BOR_Sunsteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/QuantumRebreather/quantum_rebreather</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_I</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="BOR_QualityHeadgearBase">
    <defName>BOR_Sunforge_Calibration_Visor</defName>
    <label>sunforge calibration visor</label>
    <description>A narrow visor that filters glare and timing drift for precision forging. It is tuned to keep the wearer visually locked onto heat gradients, seams, and microscopic alignment cues.</description>
    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/CalibrationVisor/calibration_visor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.60</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>22000</WorkToMake>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>0.88</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.00</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.46</ArmorRating_Heat>
      <Insulation_Cold>3</Insulation_Cold>
      <Insulation_Heat>1.25</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <BOR_QuantumForging>0.10</BOR_QuantumForging>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_Headgear_I</li>
    </thingCategories>
    <costList>
      <BOR_Sunsteel>31</BOR_Sunsteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/CalibrationVisor/calibration_visor</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_I</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
  </ThingDef>

  <!-- Armor / shells -->

  <ThingDef ParentName="BOR_NoQualityWearableBase">
    <defName>BOR_Quantum_Haptic_Gloves</defName>
    <label>quantum haptic gloves</label>
    <description>Fine haptic gloves tuned for microscopic substrate handling. They translate tactile feedback into stable, deliberate motion without relying on item quality to do the work.</description>
    <graphicData>
      <texPath>BOR/Things/Item/Equipment/apparelless/haptic_gloves</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.17</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>0.03</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.01</ArmorRating_Blunt>
      <ArmorRating_Heat>0.02</ArmorRating_Heat>
      <EquipDelay>1.65</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <BOR_Synthesize_Neutronium>0.13</BOR_Synthesize_Neutronium>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Apparel</li>
    </thingCategories>
    <costList>
      <BOR_Sunsteel>13</BOR_Sunsteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Hands</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>Clothing</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Clothing</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
  </ThingDef>

