<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="BOR_QualityHeadgearBase" ParentName="ArmorHelmetMakeableBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef Name="BOR_QualityArmorBase" ParentName="ArmorMachineableBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef Name="BOR_NoQualityWearableBase" ParentName="ApparelNoQualityBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_I</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_I</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
  </ThingDef>

  <!-- Headgear -->

  <ThingDef ParentName="BOR_QualityHeadgearBase">
    <defName>BOR_QuantumRebreatherMask</defName>
    <label>quantum rebreather mask</label>
    <description>A filtered quantum rebreather built for hazardous substrate work. The mask stabilizes breathing feedback and keeps the wearer steady in environments where fine pressure control matters more than raw armor.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/EltexHelmet/EltexHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.90</drawSize>
      <color>(0.28, 0.58, 0.66)</color>
    </graphicData>
    <statBases>
      <WorkToMake>31500</WorkToMake>
      <MaxHitPoints>225</MaxHitPoints>
      <Mass>1.0</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.4</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <ArmorRating_Heat>0.65</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <BOR_Synthesize_Neutronium>0.12</BOR_Synthesize_Neutronium>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_Headgear_I</li>
    </thingCategories>
    <costList>
      <BOR_Sunsteel>35</BOR_Sunsteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/EltexHelmet/EltexHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_I</li>
      <li>BOR_Tech_I</li>
    </tradeTags>
  </ThingDef>

