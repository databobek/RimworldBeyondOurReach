    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_Headgear_I</li>
    </thingCategories>
    <costList>
      <BOR_Sunsteel>28</BOR_Sunsteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
