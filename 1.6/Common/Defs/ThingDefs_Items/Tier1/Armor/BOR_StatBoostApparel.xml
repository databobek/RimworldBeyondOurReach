    </graphicData>
    <statBases>
      <WorkToMake>22000</WorkToMake>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>0.8</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
