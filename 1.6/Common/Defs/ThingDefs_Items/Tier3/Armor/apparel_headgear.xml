    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/Tier3Helmet/Tier3Helmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.25</uiIconScale>
