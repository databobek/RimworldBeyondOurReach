<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ======================================= Industrial =======================================-->

  <ThingDef ParentName="ArmorMachineableBase">
    <defName>BOR_Quasar_Assembly_Carapace</defName>
    <label>kwazaari assembly carapace</label>
    <description>A rigid carapace built around the principle of sustained surgical control. Its alloy structural web locks the torso and shoulders into a configuration optimized for continuous bionic implant work at the highest precision tier. Unlike the harness of the solar craftsman, this piece does not compromise — it is built for one purpose, and it excels at it.</description>
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <researchPrerequisites>
        <li>BOR_Research_Armor_II</li>
        <li>FlakArmor</li>
      </researchPrerequisites>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>220</displayPriority>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_II</li>
      </recipeUsers>
    </recipeMaker>
    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/AssemblyCarapace/assembly_carapace</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>75000</WorkToMake>
      <MaxHitPoints>600</MaxHitPoints>
      <Mass>7.80</Mass>
      <Flammability>0.22</Flammability>
      <ArmorRating_Sharp>2.00</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.75</ArmorRating_Blunt>
      <ArmorRating_Heat>0.95</ArmorRating_Heat>
      <Insulation_Cold>68</Insulation_Cold>
      <Insulation_Heat>18</Insulation_Heat>
      <EquipDelay>11.50</EquipDelay>
      <MarketValue>25000</MarketValue>

      <RoyalFavorValue>3</RoyalFavorValue>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.80</ToxicEnvironmentResistance>
      <MoveSpeed>-0.05</MoveSpeed>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.35</VacuumResistance>
      <BOR_BionicCraftingSpeed>0.25</BOR_BionicCraftingSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_II</li>
    </thingCategories>
    <costList>
      <BOR_QuasarAlloy>100</BOR_QuasarAlloy>
      <BOR_Neutronium>10</BOR_Neutronium>
      <BOR_ComponentII>4</BOR_ComponentII>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/AssemblyCarapace/assembly_carapace</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>HiTechArmor</li>
        <li>BOR_Military_II</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Armor</li>
      <li>BOR_Armor_II</li>
      <li>BOR_Tech_II</li>
    </tradeTags>
  </ThingDef>

