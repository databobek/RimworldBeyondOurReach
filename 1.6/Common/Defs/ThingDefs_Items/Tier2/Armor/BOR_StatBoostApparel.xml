      <recipeUsers Inherit="False">
        <li>BOR_Bench_II</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef Name="BOR_QualityArmorBase_II" ParentName="ArmorMachineableBase" Abstract="True">
