<Defs>

  <ThingDef ParentName="ArmorMachineableBase">
    <defName>BOR_Quasar_Apparel_ArmorRecon</defName>
    <label>kwazaari light armor</label>
    <description>Partially-powered armor, designed for mobility and ease-of-use. Meshes of Kwazaari Weave block attacks without adding excessive weight, and a complex endomuscular system in the lower body allows for uncompromised movement.\n\nArmor such as this is often employed by kwazaari scout troops and higher-end police forces.</description>
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisites>
        <li>BOR_Research_Armor_II</li>
        <li>ReconArmor</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>BOR_Bench_II</li>
        <li>BOR_Bench_IV</li>
      </recipeUsers>
      <displayPriority>116</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>BOR/Things/Pawn/Humanlike/Apparel/Tier2TrooperArmor/Tier2Armor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <generateCommonality>1.1</generateCommonality>
    <statBases>
      <WorkToMake>90000</WorkToMake>
      <MaxHitPoints>500</MaxHitPoints>
      <Mass>6</Mass>
      <Flammability>0.2</Flammability>
      <ArmorRating_Sharp>2.21</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.50</ArmorRating_Blunt>
      <ArmorRating_Heat>0.77</ArmorRating_Heat>
      <Insulation_Cold>60</Insulation_Cold>
      <Insulation_Heat>22</Insulation_Heat>
      <EquipDelay>10</EquipDelay>
      <MarketValue>18500</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.1</MoveSpeed>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.35</VacuumResistance>
    </equippedStatOffsets>
    <thingCategories>
      <li>BOR_Armor_II</li>
    </thingCategories>
    <costList>
      <BOR_ComponentII>3</BOR_ComponentII>
      <BOR_QuasarAlloy>88</BOR_QuasarAlloy>
      <BOR_QuasarAlloyWeave>11</BOR_QuasarAlloyWeave>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <useWornGraphicMask>true</useWornGraphicMask>
      <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/Tier2TrooperArmor/Tier2Armor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>HiTechArmor</li>
        <li>BOR_Military_II</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <tradeTags>
      <li>HiTechArmor</li>
      <li>BOR_HiTechArmor_II</li>
      <li>BOR_Tech_II</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_Biocodable" />
    </comps>
    <thingSetMakerTags>
      <li>RewardStandardMidFreq</li>
    </thingSetMakerTags>
  </ThingDef>

