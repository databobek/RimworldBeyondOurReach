<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef Name="BOR_TenebralSurgeryInstallImplantBase" ParentName="BOR_QuasarSurgeryInstallImplantBase" Abstract="True">
    <workAmount>15000</workAmount>
    <skillRequirements>
      <Medicine>18</Medicine>
    </skillRequirements>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>BOR_MedicineIII</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BOR_MedicineIII</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

  <HediffDef ParentName="BOR_ImplantTenebralHediffBase">
    <defName>BOR_TenebralBreathPacerImplant</defName>
    <label>tenebral breath-pacer implant</label>
    <labelNoun>a tenebral breath-pacer implant</labelNoun>
    <description>An apex implanted breathing pacer that keeps the chest rhythm steady under extreme substrate stress and the harshest procedural loads.</description>
    <descriptionHyperlinks>
      <ThingDef>BOR_TenebralOrgan</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>BOR_TenebralOrgan</spawnThingOnRemoved>
    <stages Inherit="False">
      <li>
        <painOffset>0.02</painOffset>
        <statOffsets>
          <BOR_QuantumForging>1.1</BOR_QuantumForging>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <RecipeDef ParentName="BOR_TenebralSurgeryInstallImplantBase">
    <defName>BOR_InstallTenebralBreathPacerImplant</defName>
    <label>install tenebral breath-pacer implant</label>
    <description>Install a tenebral breath-pacer implant.</description>
    <descriptionHyperlinks>
      <ThingDef>BOR_TenebralOrgan</ThingDef>
      <HediffDef>BOR_TenebralBreathPacerImplant</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing tenebral breath-pacer implant.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BOR_TenebralOrgan</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BOR_TenebralOrgan</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
    <addsHediff>BOR_TenebralBreathPacerImplant</addsHediff>
  </RecipeDef>

