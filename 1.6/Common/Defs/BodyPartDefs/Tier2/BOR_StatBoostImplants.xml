  <HediffDef ParentName="BOR_ImplantQuasarHediffBase">
    <defName>BOR_QuasarBreathPacerImplant</defName>
    <label>kwazaari breath-pacer implant</label>
    <labelNoun>a kwazaari breath-pacer implant</labelNoun>
    <description>An advanced implanted breathing pacer that keeps the chest rhythm steady under heavier substrate pressure and more complex breathing workloads.</description>
    <descriptionHyperlinks>
      <ThingDef>BOR_QuasarBreathPacerImplant</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>BOR_QuasarBreathPacerImplant</spawnThingOnRemoved>
    <stages>
      <li>
        <statOffsets>
          <BOR_QuantumForging>0.55</BOR_QuantumForging>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="QuasarBodyPartBionicBase">
    <defName>BOR_QuasarBreathPacerImplant</defName>
    <label>kwazaari breath-pacer implant</label>
    <description>An advanced implanted diaphragm regulator tuned for heavier substrate work and harsher environments.</description>
    <descriptionHyperlinks>
      <RecipeDef>BOR_InstallQuasarBreathPacerImplant</RecipeDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/Health/HealthItem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <costList>
      <BOR_QuasarAlloy>11</BOR_QuasarAlloy>
      <BOR_ComponentII>3</BOR_ComponentII>
    </costList>
    <statBases>
      <Mass>0.18</Mass>
      <MarketValue>900</MarketValue>
    </statBases>
  </ThingDef>

  <RecipeDef ParentName="BOR_QuasarSurgeryInstallImplantBase">
    <defName>BOR_InstallQuasarBreathPacerImplant</defName>
    <label>install kwazaari breath-pacer implant</label>
    <description>Install a kwazaari breath-pacer implant.</description>
    <descriptionHyperlinks>
      <ThingDef>BOR_QuasarBreathPacerImplant</ThingDef>
      <HediffDef>BOR_QuasarBreathPacerImplant</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing kwazaari breath-pacer implant.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BOR_QuasarBreathPacerImplant</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BOR_QuasarBreathPacerImplant</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
    <addsHediff>BOR_QuasarBreathPacerImplant</addsHediff>
  </RecipeDef>

