    <WorkGiverDef>
        <defName>BOR_ResourceDrill</defName>
        <label>drill at resource drill</label>
        <giverClass>CVN_EnhancedResourceDrill.WorkGiver_DrillAtResourceDrill</giverClass>
        <workType>Mining</workType>
        <priorityInType>50</priorityInType>
        <verb>drill</verb>
        <gerund>drilling</gerund>
        <requiredCapacities>
            <li>Manipulation</li>
        </requiredCapacities>
        <canBeDoneByMechs>true</canBeDoneByMechs>
        <modExtensions>
            <li Class="CVN_EnhancedResourceDrill.DefModExtension_ResourceDrill">
                <DrillThingDef>BOR_ResourceDrill</DrillThingDef>
                <DrillJobDef>CVN_OperateResourceDrill</DrillJobDef>
            </li>
        </modExtensions>
    </WorkGiverDef>

    <WorkGiverDef>
        <defName>BOR_ResourceDrill_II</defName>
        <label>drill at kwazaari resource drill</label>
        <giverClass>CVN_EnhancedResourceDrill.WorkGiver_DrillAtResourceDrill</giverClass>
