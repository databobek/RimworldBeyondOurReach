            </li>
        </modExtensions>
    </WorkGiverDef>

    <RePower.RePowerDef MayRequire="mlie.repower.patchpack">
        <!-- My Core Drill -->
        <defName>RePowerBorDrill</defName>
        <targetDef>BOR_ResourceDrill</targetDef>
        <lowPower>-1000</lowPower>
        <highPower>-20000</highPower>
        <poweredWorkbench>true</poweredWorkbench>
        <poweredReservable>false</poweredReservable>
    </RePower.RePowerDef>

    <RePower.RePowerDef MayRequire="mlie.repower.patchpack">
