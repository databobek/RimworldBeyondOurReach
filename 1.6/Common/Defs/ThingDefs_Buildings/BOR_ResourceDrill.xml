<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>BOR_ResourceDrill</defName>
        <label>crust driller</label>
        <description>The final upgrade of the deep drilling systems, the crust driller goes deep into the the planetary crust to extract valuable resources.</description>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>BOR/Retextures/drill</texPath>
            <drawSize>(3.5, 3.5)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.52, 0.53, 0.09)</volume>
                <offset>(0,0,-0.43)</offset>
            </shadowData>
            <drawOffset>(0,2,0.112)</drawOffset>
        </graphicData>
        <size>(3,3)</size>
        <tickerType>Normal</tickerType>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <fillPercent>0.5</fillPercent>
        <multipleInteractionCellOffsets>
            <li>(0,0,-2)</li>
        </multipleInteractionCellOffsets>
        <designationCategory>BOR</designationCategory>
        <designationHotKey>Misc12</designationHotKey>
        <rotatable>true</rotatable>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
        <uiIconOffset>(0, 0.03)</uiIconOffset>
        <uiIconScale>0.85</uiIconScale>
        <building>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
            <destroySound>BuildingDestroyed_Metal_Small</destroySound>
            <relatedBuildCommands>
                <li>BOR_ResourceDrill_II</li>
                <li>BOR_ResourceDrill_III</li>
            </relatedBuildCommands>
        </building>
        <costList>
            <Plasteel>2000</Plasteel>
            <ComponentSpacer>10</ComponentSpacer>
            <BOR_Sunsteel>400</BOR_Sunsteel>
        </costList>
        <placeWorkers>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <inspectorTabs>
            <li>CVN_EnhancedResourceDrill.ITab_ResourceDrill</li>
        </inspectorTabs>
        <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        <researchPrerequisites>
            <li>BOR_Research_Core_Drill</li>
        </researchPrerequisites>
        <statBases>
            <MaxHitPoints>5000</MaxHitPoints>
            <WorkToBuild>10000</WorkToBuild>
            <Flammability>0.5</Flammability>
            <Beauty>-25</Beauty>
        </statBases>
        <comps>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>20000</basePowerConsumption>
            </li>
            <li Class="CompProperties_CreatesInfestations" />
            <li Class="CVN_EnhancedResourceDrill.CompProperties_ResourceDrill">
                <!-- what to display when resource not selected -->
                <selectResourceUiIcon>UI/Designators/Mine</selectResourceUiIcon>
                <!-- whether humans are involved -->
                <isAutomatic>False</isAutomatic>
                <!-- update job status every 60 ticks -->
                <tickInterval>60</tickInterval>
                <!-- how much work is done per tick interval multiplied by number of pawns -->
                <workPerInterval>15</workPerInterval>
                <operateJobDef>CVN_OperateResourceDrill</operateJobDef>
                <!-- default baseWorkAmount -->
                <!-- bigger -> slower -->
                <baseWorkAmount>10</baseWorkAmount>
                <!-- fixed work amount means pawn skills dont matter -->
                <isFixedWorkAmount>false</isFixedWorkAmount>
                <!-- uses a specific formula to dictate work amounts based on drillable availabilities -->
                <allowAnyDeepdrillResource>true</allowAnyDeepdrillResource>
                <!-- if allowAnyDeepdrillResource is set to TRUE, if isInvertWhitelist is also TRUE, the drillableResources will act as a blacklist instead -->
                <!-- otherwise, drillableResources will be added on top of all deep resource -->
                <isInvertWhitelist>true</isInvertWhitelist>
                <resourceYield>20</resourceYield>
                <!-- drillable or undrillable depending on above -->
                <drillableResources>
                    <li>
                        <thingDef>Plasteel</thingDef>
                    </li>
                    <li MayRequire="vanillaexpanded.helixiengas">
                        <thingDef>VHGE_Helixien</thingDef>
                    </li>
                    <li MayRequireAnyOf="bambaryla.bor,bambaryla.bor.redux">
                        <thingDef>BOR_Neutronium</thingDef>
                    </li>
                    <!-- values below overwrite anything else -->
                    <!-- <li>
                        <thingDef>WoodLog</thingDef>
                        <amount>25~50</amount>
                        <fixedWorkAmount>true</fixedWorkAmount>
                        <workAmount>600</workAmount>
                    </li> -->
                </drillableResources>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>BOR_ResourceDrill_II</defName>
        <label>kwazaari crust driller</label>
        <description>An upgraded crust driller built from kwazaari-grade materials. It supports coordinated multi-operator drilling from all cardinal approach angles.</description>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>BOR/Retextures/firecontrol2</texPath>
            <drawSize>(3.5, 3.5)</drawSize>
            <drawRotated>false</drawRotated>
            <shadowData>
                <volume>(0.52, 0.53, 0.09)</volume>
                <offset>(0,0,-0.43)</offset>
            </shadowData>
            <drawOffset>(0,2,0.112)</drawOffset>
        </graphicData>
        <size>(3,3)</size>
        <tickerType>Normal</tickerType>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <fillPercent>0.5</fillPercent>
        <multipleInteractionCellOffsets>
            <li>(0,0,-2)</li>
            <li>(0,0,2)</li>
            <li>(-2,0,0)</li>
            <li>(2,0,0)</li>
        </multipleInteractionCellOffsets>
        <designationCategory>BOR</designationCategory>
        <designationHotKey>Misc12</designationHotKey>
        <rotatable>true</rotatable>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <uiIconOffset>(0, 0.03)</uiIconOffset>
        <uiIconScale>0.85</uiIconScale>
        <building>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
            <destroySound>BuildingDestroyed_Metal_Small</destroySound>
            <relatedBuildCommands>
                <li>BOR_ResourceDrill</li>
                <li>BOR_ResourceDrill_III</li>
            </relatedBuildCommands>
        </building>
        <costList>
            <BOR_QuasarAlloy>400</BOR_QuasarAlloy>
            <BOR_ComponentII>10</BOR_ComponentII>
        </costList>
        <placeWorkers>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <inspectorTabs>
            <li>CVN_EnhancedResourceDrill.ITab_ResourceDrill</li>
        </inspectorTabs>
        <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        <researchPrerequisites>
            <li>BOR_Research_Core_Drill_II</li>
        </researchPrerequisites>
        <statBases>
            <MaxHitPoints>7500</MaxHitPoints>
            <WorkToBuild>15000</WorkToBuild>
            <Flammability>0.0</Flammability>
            <Beauty>-10</Beauty>
        </statBases>
        <comps>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>40000</basePowerConsumption>
            </li>
            <li Class="CVN_EnhancedResourceDrill.CompProperties_ResourceDrill">
                <selectResourceUiIcon>UI/Designators/Mine</selectResourceUiIcon>
                <isAutomatic>False</isAutomatic>
                <tickInterval>60</tickInterval>
                <workPerInterval>30</workPerInterval>
                <operateJobDef>CVN_OperateResourceDrill</operateJobDef>
                <baseWorkAmount>10</baseWorkAmount>
                <isFixedWorkAmount>false</isFixedWorkAmount>
                <allowAnyDeepdrillResource>true</allowAnyDeepdrillResource>
                <resourceYield>40</resourceYield>
                <isInvertWhitelist>true</isInvertWhitelist>
                <drillableResources>
                    <li>
                        <thingDef>Plasteel</thingDef>
                    </li>
                    <li MayRequire="vanillaexpanded.helixiengas">
                        <thingDef>VHGE_Helixien</thingDef>
                    </li>
                    <li MayRequireAnyOf="bambaryla.bor,bambaryla.bor.redux">
                        <thingDef>BOR_Neutronium</thingDef>
                    </li>
                </drillableResources>
            </li>
        </comps>
    </ThingDef>

