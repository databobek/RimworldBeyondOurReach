<Defs>

    <!-- ==================== Judgment-class Ship Cannon ==================== -->

    <ThingDef ParentName="BuildingBase">
        <defName>BOR_JudgmentShipCannon</defName>
        <hasInteractionCell>False</hasInteractionCell>
        <interactionCellOffset />
        <label>Judgment-class ship cannon</label>
        <description>A triple-barreled 33cm naval artillery installation ripped from the hulls of Solarite warships. This is the same gun that once reduced enemy fleets to scattered wreckage before they could close to return fire. On the ground it carries that same apocalyptic weight — three devastating shells per salvo, and a long, ominous recharge between volleys.</description>
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>BOR/Things/Item/Equipment/weaponranged/gen1/artillery/base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(6,6)</drawSize>
        </graphicData>
        <uiIconPath>BOR/Things/Item/Equipment/weaponranged/gen1/artillery/gun</uiIconPath>
        <size>(6,6)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <tickerType>Normal</tickerType>
        <fillPercent>0.99</fillPercent>
        <blockWind>true</blockWind>
        <canOverlapZones>false</canOverlapZones>
        <statBases>
            <MaxHitPoints>6667</MaxHitPoints>
            <WorkToBuild>750000</WorkToBuild>
            <Flammability>0</Flammability>
            <Beauty>-33</Beauty>
            <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
        </statBases>
        <costList>
            <BOR_Neutronium>550</BOR_Neutronium>
            <BOR_Tenebrite>330</BOR_Tenebrite>
            <BOR_ComponentIII>22</BOR_ComponentIII>
        </costList>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>BOR_JudgmentShipCannon_Gun</turretGunDef>
            <turretTopDrawSize>9</turretTopDrawSize>
            <turretTopOffset>(0,1.5)</turretTopOffset>
            <turretBurstWarmupTime>4.40</turretBurstWarmupTime>
            <turretBurstCooldownTime>33</turretBurstCooldownTime>
        </building>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>12.9</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>41667</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Judgment shells (Ni)</fuelLabel>
                <fuelGizmoLabel>Judgment shells (Ni)</fuelGizmoLabel>
                <fuelFilter>
                    <thingDefs>
                        <li>BOR_Shell_JudgmentShipCannon_Ni</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>9</fuelCapacity>
                <initialFuelPercent>0</initialFuelPercent>
                <autoRefuelPercent>0.5</autoRefuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>0</minimumFueledThreshold>
                <atomicFueling>false</atomicFueling>
                <fuelMultiplier>1</fuelMultiplier>
                <factorByDifficulty>false</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <outOfFuelMessage>Cannot shoot: Out of shells</outOfFuelMessage>
                <fuelIconPath>Things/Projectile/ShellHighExplosive</fuelIconPath>
            </li>
        </comps>
        <researchPrerequisites>
            <li>BOR_Research_JudgmentCannon_I</li>
        </researchPrerequisites>
        <designationCategory>BOR</designationCategory>
        <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    </ThingDef>

