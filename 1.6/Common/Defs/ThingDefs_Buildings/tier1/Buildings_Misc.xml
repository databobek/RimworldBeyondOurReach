<?xml version="1.0" encoding="utf-8"?>
<Defs>


  <ThingDef ParentName="BuildingBase">
    <defName>BOR_Kylar_Xar_Computer</defName>
    <label>Kylar-Xar effect computer</label>
    <description>The application of Kylar-Xar effect state in computer design enables us to bypass the limitations of our industrial era designs. To create the conditions for these quantum states our computers must double as cryogenic chambers. This will require enormous systems of coolant and temperature mitigation. Only a single Kylar-Xar effect computer is needed.</description>
    <graphicData>
      <texPath>BOR/Retextures/quantumcomputer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5,3.5)</drawSize>
      <damageData>
        <rect>(0.05,0.05,0.95,0.95)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <tickerType>Normal</tickerType>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <fillPercent>0.5</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Mass>200</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Silver>1000</Silver>
      <ComponentSpacer>20</ComponentSpacer>
      <ComponentIndustrial>30</ComponentIndustrial>
      <Plasteel>300</Plasteel>
      <BOR_Sunsteel>200</BOR_Sunsteel>
      <Gold>150</Gold>
    </costList>
    <researchPrerequisites>
      <li>BOR_Kylar_Xar_Computer</li>
    </researchPrerequisites>
    <designationCategory>BOR</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li MayRequire="joeyjoejoeshabidoo.Rimputers1.4" Class="Rimputers.CompProperties_WaterConsumer">
        <waterPerTick>0.1</waterPerTick>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>5000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>50</heatPerSecond>
      </li>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>3.5</ResearchSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>15</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>BOR_Research_Unlocker_I</defName>
    <label>solar fluid simulation array</label>
    <description>Increases research speed when placed near hi-tech research bench and unlocks Solarite research projects. Each research bench can only use one solar fluid simulation array</description>
    <graphicData>
      <texPath>BOR/Things/Building/tier1/research_unlocker</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.3, 2.3)</drawSize>
      <drawOffset>(0,4,0.2)</drawOffset>
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <researchPrerequisites>
      <li>BOR_Research_Analyzer_I</li>
    </researchPrerequisites>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <designationHotKey>Misc4</designationHotKey>
    <designationCategory>BOR</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>292</MaxHitPoints>
      <WorkToBuild>15000</WorkToBuild>
      <Mass>99</Mass>
      <Flammability>0.833</Flammability>
    </statBases>
    <costList>
      <Plasteel>40</Plasteel>
      <BOR_Sunsteel>55</BOR_Sunsteel>
      <ComponentSpacer>9</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>4167</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>0.75</ResearchSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <designatorDropdown>BOR_Unlockers</designatorDropdown>
  </ThingDef>


  <ThingDef ParentName="BuildingBase">
    <defName>BOR_ToolCabinet_I</defName>
    <label>holotool cabinet</label>
    <designatorDropdown>BOR_ToolCabinets</designatorDropdown>
    <description>Increases work speed when placed near a workbench via hardlight projection technology. One workbench can use up to three holo-cabinets.</description>
    <graphicData>
      <texPath>BOR/Things/Building/tier1/production_linkable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>32</pathCost>
    <statBases>
      <MaxHitPoints>125</MaxHitPoints>
      <WorkToBuild>2700</WorkToBuild>
      <Mass>18</Mass>
      <Flammability>0.4</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <BOR_Sunsteel>220</BOR_Sunsteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
      <li>BOR_Research_Production_I</li>
    </researchPrerequisites>
    <designationCategory>BOR</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <WorkTableWorkSpeedFactor>0.135</WorkTableWorkSpeedFactor>
        </statOffsets>
        <maxSimultaneous>3</maxSimultaneous>
				<maxDistance>10</maxDistance>
      </li>
    </comps>
    <designationHotKey>Misc6</designationHotKey>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>BOR_MoisturePump_I</defName>
    <label>solar moisture pump</label>
    <description>Very slowly equalizes moisture in nearby terrain, converting marshes or shallow water into dry ground, and soft sand into normal sand. Does not affect deep water.</description>
    <graphicData>
      <texPath>Things/Building/Misc/MoisturePump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.58, 0.35, 0.25)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>188</basePowerConsumption>
      </li>
      <li Class="CompProperties_TerrainPumpDry">
        <soundWorking>MoisturePump_Ambience</soundWorking>
        <radius>10.9</radius>
        <daysToRadius>50</daysToRadius>
      </li>
    </comps>
    <tickerType>Rare</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>63</MaxHitPoints>
      <WorkToBuild>2250</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-5</Beauty>
    </statBases>
    <fillPercent>0.15</fillPercent>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <costList>
      <BOR_Sunsteel>82</BOR_Sunsteel>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <specialDisplayRadius>10.9</specialDisplayRadius>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <designationCategory>Misc</designationCategory>
    <rotatable>false</rotatable>
    <researchPrerequisites>
      <li>BOR_Research_Analyzer_I</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
  </ThingDef>

</Defs>