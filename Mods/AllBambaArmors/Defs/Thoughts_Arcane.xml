<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Eye of the archotech moods. Who gets which is set in Patches/ArmorAbilities.xml (Orientis blessed; Tenebral and Umbral seared). -->

	<ThoughtDef>
		<defName>ABT_ArchotechEyeBlessing</defName>
		<durationDays>0.05</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>in the archotech's light</label>
				<description>The eye of the archotech shines on me. I feel watched over.</description>
				<baseMoodEffect>4</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef>
		<defName>ABT_ArchotechEyeSearing</defName>
		<durationDays>0.05</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>seared by the archotech's light</label>
				<description>That golden eye burns. Everything in me wants to be out of its sight.</description>
				<baseMoodEffect>-4</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

</Defs>
