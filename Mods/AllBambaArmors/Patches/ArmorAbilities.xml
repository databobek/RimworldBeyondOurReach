<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Abilities and energy pools from "Armors For All Post-Medieval Tech Levels" (bamba.allbambaarmors), which defines them.
		Every entry has MayRequire, so nothing here applies without that mod.
		Energy uses the same scale as that mod: Advanced Spacer medium = 100; Solar x1.25, Ultra x1.25 more, Kwazaari and Orientis x1.25 more;
		light/medium/heavy x0.75/1/1.25. Each pool refills from empty in 200 seconds.
		This folder loads last (LoadFolders.xml), so it runs after EquipmentBadzaar.xml, which adds the badzaari armor outside Combat Extended.
		Royalty- and Biotech-only armor is skipped quietly when the DLC is off.
	-->

	<!-- kwazaari mechcommander helmet (Biotech): kwazaari medium, 195 energy; no mechcommander body armor exists, so the helmet carries them -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="BOR_Quasar_Apparel_ArmorHelmetMechCommander"]</xpath>
		<match Class="PatchOperationConditional">
			<xpath>Defs/ThingDef[defName="BOR_Quasar_Apparel_ArmorHelmetMechCommander"]/comps</xpath>
			<match Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="BOR_Quasar_Apparel_ArmorHelmetMechCommander"]/comps</xpath>
				<value>
					<li Class="VEF.Abilities.CompProperties_AbilitiesApparel" MayRequire="bamba.allbambaarmors">
						<abilities>
							<li>ABT_Shield</li>
							<li>ABT_ChainLightning</li>
						</abilities>
					</li>
					<li Class="AllBambaArmors.CompProperties_AbilityEnergy" MayRequire="bamba.allbambaarmors">
						<maxEnergy>195</maxEnergy>
						<regenPerSecond>0.975</regenPerSecond>
						<barColor>(0.25, 0.8, 0.75)</barColor>
					</li>
				</value>
			</match>
			<nomatch Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="BOR_Quasar_Apparel_ArmorHelmetMechCommander"]</xpath>
				<value>
					<comps>
						<li Class="VEF.Abilities.CompProperties_AbilitiesApparel" MayRequire="bamba.allbambaarmors">
							<abilities>
								<li>ABT_Shield</li>
								<li>ABT_ChainLightning</li>
							</abilities>
						</li>
						<li Class="AllBambaArmors.CompProperties_AbilityEnergy" MayRequire="bamba.allbambaarmors">
							<maxEnergy>195</maxEnergy>
							<regenPerSecond>0.975</regenPerSecond>
							<barColor>(0.25, 0.8, 0.75)</barColor>
						</li>
					</comps>
				</value>
			</nomatch>
		</match>
	</Operation>

