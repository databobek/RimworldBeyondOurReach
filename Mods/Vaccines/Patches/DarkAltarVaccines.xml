<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- The tenebral vaccines and the umbral vaccine are also made at the Dark Archotech Altar. -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="BOR_DarkArchotechAltar_III"]/comps/li[@Class="BeyondOurReach.CompProperties_DarkAltar"]/entries</xpath>
		<value>
			<li><thing>BOR_TenebralVaccine_Bio</thing></li>
			<li><thing>BOR_TenebralVaccine_Mech_I</thing></li>
			<li MayRequire="lts.MSMD"><thing>BOR_TenebralVaccine_Mech_II</thing></li>
			<li><thing>BOR_UmbralVaccine</thing></li>
		</value>
	</Operation>
</Patch>
