<?xml version="1.0" encoding="UTF-8"?>

<Patch>

    <!-- Orientis charge guns. Flash sizes and offsets are a first guess; adjust per texture. -->

    <Operation Class="SafePatcher.PatchOperationSetModExtension">
        <xpath>Defs/ThingDef[defName="BOR_Orientis_Pistol"]</xpath>
        <value>
            <li Class="MuzzleFlash.MuzzleFlashProps">
                <def>MF_StandardMuzzleFlashGood</def>
                <drawSize>(0.4,0.4)</drawSize>
                <offsets>
                    <li>(0.18,0.06)</li>
                </offsets>
                <isAlternately>true</isAlternately>
            </li>
        </value>
    </Operation>

