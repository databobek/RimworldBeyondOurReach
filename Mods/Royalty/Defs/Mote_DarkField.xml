<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Royalty's proximity-scanner ring, sized to the dread beacon's 15.9 radius. The texture ships with Royalty only;
	     without Royalty the beacon draws a plain red circle instead. -->
	<ThingDef ParentName="MoteBase">
		<defName>BOR_Mote_DarkFieldRadius</defName>
		<mote>
			<fadeInTime>0.1</fadeInTime>
			<solidTime>999999999</solidTime>
			<fadeOutTime>0.5</fadeOutTime>
			<needsMaintenance>True</needsMaintenance>
		</mote>
		<drawOffscreen>true</drawOffscreen>
		<graphicData>
			<texPath>Things/Mote/ActivatorProximityRadius</texPath>
			<shaderType>MoteProximityScannerRadius</shaderType>
			<color>(1, 0.05, 0.05, 0.45)</color>
			<drawSize>31.8</drawSize>
			<shaderParameters>
				<_smokeScrollSpeed>0.1</_smokeScrollSpeed>
				<_rotationSpeed>0.1</_rotationSpeed>
				<_smokeAmount>0.7</_smokeAmount>
				<_MainTex>/Things/Mote/ActivatorProximityRadius</_MainTex>
				<_ScanTex>/Things/Mote/ActivatorProximityScanning</_ScanTex>
				<_SmokeTex>/Things/Mote/SmokeTiled</_SmokeTex>
			</shaderParameters>
		</graphicData>
	</ThingDef>

</Defs>
