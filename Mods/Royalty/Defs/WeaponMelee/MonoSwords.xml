  <ThingDef ParentName="MeleeWeaponUltratech">
    <defName>BOR_Solar_MonoBastardSword</defName>
    <tradeTags>
    	<li>BOR_Tech_I</li>
    </tradeTags>
    <label>solar mono bastard sword</label>
    <description>A refined crystal-metallic bastard sword tuned to Solarite mono-molecular calibration standards. Its edge maintains a sharper cutting field while a lighter mechanite lattice allows for quicker strikes.</description>
    <soundInteract>Interact_MonoSword</soundInteract>
    <meleeHitSound>MeleeHit_MonoSword</meleeHitSound>
    <smeltable>false</smeltable>
    <equippedAngleOffset>5</equippedAngleOffset>
    <relicChance>3</relicChance>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>4</Mass>
    </statBases>
    <weaponClasses>
      <li>Melee</li>
      <li>MeleePiercer</li>
    </weaponClasses>
    <graphicData>
      <texPath>BOR/Things/Item/Equipment/mono/longsword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <equippedStatOffsets>
      <MoveSpeed>-0.08</MoveSpeed>
    </equippedStatOffsets>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>1.44</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>37.5</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>1.125</armorPenetration>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>37.5</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>1.125</armorPenetration>
      </li>
    </tools>
  </ThingDef>

