<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Daedalus kinds join the Solar groups with Royalty -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[defName="BOR_SolarRepublic"]/pawnGroupMakers/li[kindDef="Combat"]/options</xpath>
		<value>
			<BOR_Solar_DaedalusTrooper>1</BOR_Solar_DaedalusTrooper>
			<BOR_Solar_DaedalusAssaulter>1</BOR_Solar_DaedalusAssaulter>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[defName="BOR_SolarRepublic"]/pawnGroupMakers/li[kindDef="Settlement"]/options</xpath>
		<value>
			<BOR_Solar_DaedalusTrooper>1</BOR_Solar_DaedalusTrooper>
			<BOR_Solar_DaedalusAssaulter>1</BOR_Solar_DaedalusAssaulter>
		</value>
	</Operation>
</Patch>
