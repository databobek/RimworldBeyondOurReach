										<soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
									</li>
								</tools>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="KneeSpikeTenebral"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools</xpath>
							<value>
								<tools>
