<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- patch sequence to patch in defs while proceeding to check for CE -->
			<!-- consolidate tier3 non-brain organ groups -->
			<!-- consolidate tier3 armor glands -->
			<!-- check to see if CombatExtended is loaded as well, then modify the patched in defs to CE standards -->
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Combat Extended</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<!-- Bionics -->
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="OmniArmorGlandTenebral"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
							<value>
								<ArmorRating_Sharp>24.075</ArmorRating_Sharp>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="OmniArmorGlandTenebral"]/stages/li/statOffsets/ArmorRating_Blunt</xpath>
							<value>
								<ArmorRating_Blunt>34.85</ArmorRating_Blunt>
							</value>
						</li>
						<li Class="PatchOperationAdd">
							<xpath>Defs/HediffDef[defName="OmniArmorGlandTenebral"]/stages/li/statOffsets</xpath>
							<value>
								<MoveSpeed>-0.89</MoveSpeed>
								<MeleeDodgeChance>-0.077</MeleeDodgeChance>
							</value>
						</li>
						<li Class="PatchOperationRemove">
							<xpath>Defs/HediffDef[defName="OmniArmorGlandTenebral"]/stages/li/capMods</xpath>
						</li>
					</operations>
				</match>
			</li>
		</operations>
	</Operation>
</Patch>