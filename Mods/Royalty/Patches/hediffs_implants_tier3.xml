										<label>drill</label>
										<capacities>
											<li>Stab</li>
										</capacities>
										<power>48</power>
										<cooldownTime>0.5</cooldownTime>
										<armorPenetrationSharp>0.24</armorPenetrationSharp>
										<armorPenetrationBlunt>1.8</armorPenetrationBlunt>
