<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- patch sequence to patch in defs while proceeding to check for CE -->
			<!-- add Royalty-dependent pawn tech hediffs after implant defs are injected -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[@Name="BOR_BasePawn_II"]/techHediffsRequired</xpath>
				<value>
					<li>ArmorGlandQuasar</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[defName="BOR_Town_Trader_II"]</xpath>
				<value>
					<techHediffsRequired>
						<li>PsychicModuleQuasar</li>
					</techHediffsRequired>
				</value>
			</li>
			<!-- consolidate tier2 nose/recovery implants -->
			<!-- check to see if CombatExtended is loaded as well, then modify the patched in defs to CE standards -->
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Combat Extended</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<!-- Bionics -->
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="ArmorGlandQuasar"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
							<value>
								<ArmorRating_Sharp>4.13</ArmorRating_Sharp>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="ArmorGlandQuasar"]/stages/li/statOffsets/ArmorRating_Blunt</xpath>
							<value>
								<ArmorRating_Blunt>6.37</ArmorRating_Blunt>
							</value>
						</li>
						<li Class="PatchOperationAdd">
							<xpath>Defs/HediffDef[defName="ArmorGlandQuasar"]/stages/li/statOffsets</xpath>
							<value>
								<MoveSpeed>-0.71</MoveSpeed>
								<MeleeDodgeChance>-0.054</MeleeDodgeChance>
							</value>
						</li>
						<li Class="PatchOperationRemove">
							<xpath>Defs/HediffDef[defName="ArmorGlandQuasar"]/stages/li/capMods</xpath>
						</li>
					</operations>
				</match>
			</li>
		</operations>
	</Operation>
</Patch>