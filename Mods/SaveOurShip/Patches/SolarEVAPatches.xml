<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- apparels -->
			<!-- EVA description -->
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor" or defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"][not(comps)]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor" or defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"][not(comps)]</xpath>
					<value>
						<comps />
					</value>
				</match>
			</li>

			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor" or defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"]/comps[not(li/compClass="SaveOurShip2.CompEVA")]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor" or defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"]/comps[not(li/compClass="SaveOurShip2.CompEVA")]</xpath>
					<value>
						<li>
							<compClass>SaveOurShip2.CompEVA</compClass>
						</li>
					</value>
				</match>
			</li>

			<!-- EVA stats -->
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor" or defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"][not(equippedStatOffsets)]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor" or defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"][not(equippedStatOffsets)]</xpath>
					<value>
						<equippedStatOffsets />
					</value>
				</match>
			</li>

			<!-- Armor DecompressionResistance -->
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor"]/equippedStatOffsets[not(DecompressionResistance)]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon" or defName="BOR_Solar_Apparel_PowerArmor"]/equippedStatOffsets[not(DecompressionResistance)]</xpath>
					<value>
						<DecompressionResistance>0.85</DecompressionResistance>
					</value>
				</match>
			</li>

			<!-- Helmets DecompressionResistance -->
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"]/equippedStatOffsets[not(DecompressionResistance)]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"]/equippedStatOffsets[not(DecompressionResistance)]</xpath>
					<value>
						<DecompressionResistance>0.35</DecompressionResistance>
					</value>
				</match>
			</li>

			<!-- Helmets HypoxiaResistance -->
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"]/equippedStatOffsets[not(HypoxiaResistance)]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorHelmetRecon" or defName="BOR_Solar_Apparel_PowerArmorHelmet"]/equippedStatOffsets[not(HypoxiaResistance)]</xpath>
					<value>
						<HypoxiaResistance>1</HypoxiaResistance>
					</value>
				</match>
			</li>

			<!-- Recon Armor Insulation_Cold -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_ArmorRecon"]/statBases/Insulation_Cold</xpath>
				<value>
					<Insulation_Cold>100</Insulation_Cold>
				</value>
			</li>

			<!-- Marine Armor Insulation_Cold -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="BOR_Solar_Apparel_PowerArmor"]/statBases/Insulation_Cold</xpath>
				<value>
					<Insulation_Cold>110</Insulation_Cold>
				</value>
			</li>
		</operations>
	</Operation>


</Patch>