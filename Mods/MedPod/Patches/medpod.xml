<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- tier integration: costs, power and research, driven by the Mod Settings Framework menu -->
	<Operation Class="BeyondOurReach.PatchOperationTierIntegration">
		<id>BOR_MedPod_Tier</id>
		<category>BOR_MedPod</category>
		<label>Technology tier</label>
		<tooltip>Ultra keeps the original mod untouched. Solar, Kwazaari and Tenebral move the buildings and their research to the matching Beyond Our Reach tier. Needs a game restart.</tooltip>
		<tierLabel>Technology tier</tierLabel>
		<costLabel>Research cost</costLabel>
		<researchDef>AcceleratedCellularRegeneration</researchDef>
		<defaultTier>2</defaultTier>
		<minCost>6000</minCost>
		<maxCost>10000000</maxCost>
		<things>
			<li>MedPodStandard</li>
			<li>MedPodAnimal</li>
			<li>MedPodAnimalMedium</li>
			<li>MedPodAnimalBig</li>
			<li>MedPodLux</li>
		</things>
		<powerOverrides>
			<li><xpath>Defs/ThingDef[defName="MedPodStandard"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath><value>50000</value></li>
			<li><xpath>Defs/ThingDef[defName="MedPodAnimal"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath><value>15000</value></li>
			<li><xpath>Defs/ThingDef[defName="MedPodAnimalMedium"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath><value>30000</value></li>
			<li><xpath>Defs/ThingDef[defName="MedPodAnimalBig"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath><value>65000</value></li>
			<li><xpath>Defs/ThingDef[defName="MedPodLux"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath><value>50000</value></li>
		</powerOverrides>
		<tiers>
			<li>
				<label>Ultra (original)</label>
				<researchCost>6000</researchCost>
			</li>
			<li>
				<label>Solar</label>
				<researchCost>100000</researchCost>
				<techLevel>Ultra</techLevel>
				<prerequisite>BOR_Research_Medicine_I</prerequisite>
				<facility>BOR_Research_Unlocker_I</facility>
				<researchViewX>3.00</researchViewX>
				<researchViewY>4.50</researchViewY>
				<substitutions>
					<li><source>Plasteel</source><target>BOR_Sunsteel</target></li>
					<li><source>Steel</source><target>Plasteel</target></li>
					<li><source>ComponentIndustrial</source><target>ComponentSpacer</target></li>
				</substitutions>
			</li>
			<li>
				<label>Kwazaari</label>
				<researchCost>500000</researchCost>
				<techLevel>Ultra</techLevel>
				<prerequisite>BOR_Research_Medicine_II</prerequisite>
				<facility>BOR_Research_Unlocker_II</facility>
				<researchViewX>10.00</researchViewX>
				<researchViewY>3.60</researchViewY>
				<substitutions>
					<li><source>Plasteel</source><target>BOR_QuasarAlloy</target></li>
					<li><source>Steel</source><target>BOR_Sunsteel</target></li>
					<li><source>ComponentSpacer</source><target>BOR_ComponentII</target></li>
					<li><source>ComponentIndustrial</source><target>ComponentSpacer</target></li>
				</substitutions>
			</li>
			<li>
				<label>Tenebral</label>
				<researchCost>1000000</researchCost>
				<techLevel>Archotech</techLevel>
				<prerequisite>BOR_Research_Medicine_III</prerequisite>
				<facility>BOR_Research_Unlocker_III</facility>
				<researchViewX>16.00</researchViewX>
				<researchViewY>3.60</researchViewY>
				<substitutions>
					<li><source>Plasteel</source><target>BOR_Tenebrite</target></li>
					<li><source>Steel</source><target>BOR_QuasarAlloy</target></li>
					<li><source>ComponentSpacer</source><target>BOR_ComponentIII</target></li>
					<li><source>ComponentIndustrial</source><target>BOR_ComponentII</target></li>
				</substitutions>
			</li>
		</tiers>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- category -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="MedPodAnimalBig" or defName="MedPodAnimalMedium" or defName="MedPodAnimal" or defName="MedPodStandard"]</xpath>
				<value>
					<designationCategory>BOR</designationCategory>
				</value>
			</li>
			<!-- dropdown -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="MedPodAnimalBig" or defName="MedPodAnimalMedium" or defName="MedPodAnimal" or defName="MedPodStandard"]</xpath>
				<value>
					<designatorDropdown>BOR_MedPod</designatorDropdown>
				</value>
			</li>
			<!-- luxpod -->
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Royalty</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<!-- category -->
						<li Class="PatchOperationAdd">
							<xpath>Defs/ThingDef[defName="MedPodLux"]</xpath>
							<value>
								<designationCategory>BOR</designationCategory>
							</value>
						</li>
						<!-- dropdown -->
						<li Class="PatchOperationAdd">
							<xpath>Defs/ThingDef[defName="MedPodLux"]</xpath>
							<value>
								<designatorDropdown>BOR_MedPod</designatorDropdown>
							</value>
						</li>
						<!-- trade tags -->
						<li Class="PatchOperationAdd">
							<xpath>Defs/ThingDef[defName="IsolinearProcessor"]/tradeTags</xpath>
							<value>
								<li>BOR_Tech_II</li>
							</value>
						</li>
					</operations>
				</match>
			</li>

		</operations>
	</Operation>

</Patch>
