<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Melee Weapons For All Post-Medieval Tech Levels: the Dark Archotech Altar also offers the tenebral melee set. -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="BOR_DarkArchotechAltar_III"]/comps/li[@Class="BeyondOurReach.CompProperties_DarkAltar"]/entries</xpath>
		<value>
			<li><thing>Bamba_Melee_Tenebral_Knife</thing></li>
			<li><thing>Bamba_Melee_Tenebral_Gladius</thing></li>
			<li><thing>Bamba_Melee_Tenebral_Longsword</thing></li>
			<li><thing>Bamba_Melee_Tenebral_Hammer</thing></li>
			<li><thing>Bamba_Melee_Tenebral_Polehammer</thing></li>
			<li><thing>Bamba_Melee_Tenebral_Mace</thing></li>
			<li><thing>Bamba_Melee_Tenebral_Baton</thing></li>
			<li><thing>Bamba_Melee_Tenebral_Spear</thing></li>
			<li MayRequire="ceteam.combatextended"><thing>Bamba_Melee_Tenebral_Shield</thing></li>
		</value>
	</Operation>

	<!-- The tenebral shield is altar-only: drop its bench recipe. -->
	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>/Defs/ThingDef[defName="Bamba_Melee_Tenebral_Shield"]/recipeMaker</xpath>
	</Operation>
</Patch>
