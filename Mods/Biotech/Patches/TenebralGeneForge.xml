<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Gene Forge tab on the tenebral pod; the list merges with the casket tab inherited from the base def. -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="BOR_TenebralPod_III"]</xpath>
		<value>
			<inspectorTabs>
				<li>BeyondOurReach.ITab_GeneForge</li>
			</inspectorTabs>
		</value>
	</Operation>
</Patch>
