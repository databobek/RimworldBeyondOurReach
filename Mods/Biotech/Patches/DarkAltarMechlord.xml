		<xpath>/Defs/ThingDef[defName="BOR_DarkArchotechAltar"]/comps/li[@Class="BeyondOurReach.CompProperties_DarkAltar"]/entries</xpath>
		<value>
			<li><thing>BOR_Tenebral_Apparel_MechlordSuit</thing></li>
			<li><thing>BOR_Tenebral_Apparel_ArmorHelmetMechlordHelmet</thing></li>
			<li><thing>BOR_Tenebral_Apparel_ArmorHelmetMechCommander</thing></li>
			<li><thing>BOR_Apparel_TenebralMechlordSuit</thing></li>
			<li><thing>BOR_Apparel_TenebralArmorHelmetMechlordHelmet</thing></li>
		</value>
	</Operation>
</Patch>
