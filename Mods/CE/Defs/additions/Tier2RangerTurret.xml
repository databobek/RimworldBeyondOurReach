			<texPath>Things/Item/Resource/Shell/Shell_HighExplosive</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>1.98</Mass>
			<Bulk>2.75</Bulk>
		</statBases>
		<tradeTags Inherit="False">
			<li>CE_AmmoInjector</li>
			<li>CE_HeavyAmmo</li>
			<li>BOR_Tech_II</li>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_BOR_Bench_II</li>
			<li>CE_AutoEnableCrafting_BOR_Bench_IV</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoAdvanced</li>
		</thingCategories>
		<ammoClass>BOR_QaP_AmmoClass</ammoClass>
		<detonateProjectile>BOR_Bullet_Ranger_QaP</detonateProjectile>
	</ThingDef>
