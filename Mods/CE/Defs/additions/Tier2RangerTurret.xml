		<jobString>Making ranger railgun slugs (QaP).</jobString>
		<researchPrerequisites>
			<li>BOR_Research_RangerTurret_II</li>
			<li>BOR_CE_AmmoResearch_QaP</li>
		</researchPrerequisites>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>BOR_QuasarAlloy</li>
					</thingDefs>
				</filter>
				<count>40</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
