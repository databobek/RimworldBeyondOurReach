<Defs>
	<!-- Ranger railgun ammo on BOR's Quasar pattern: QaP standard, Nc as AP, Ni as HE, plus Ion. Sniper rule: QaP beats the
	     Quasar marine (60) and stops at Orientis (80); Nc beats Orientis and stops at Tenebral (107). The AP, HE and Ion def
	     names are the old ones so existing stacks survive. Recipes use quasar alloy. -->
	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_RangerRailgun</defName>
		<label>Ranger railgun slugs</label>
		<ammoTypes>
			<BOR_Ammo_Ranger_QaP>BOR_Bullet_Ranger_QaP</BOR_Ammo_Ranger_QaP>
			<BOR_Ammo_Ranger_AP>BOR_Bullet_Ranger_AP</BOR_Ammo_Ranger_AP>
			<BOR_Ammo_Ranger_HE>BOR_Bullet_Ranger_HE</BOR_Ammo_Ranger_HE>
			<BOR_Ammo_Ranger_Ion>BOR_Bullet_Ranger_Ion</BOR_Ammo_Ranger_Ion>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

