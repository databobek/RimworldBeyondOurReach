<Defs>
	<!-- Reprogramming the cartridges in a kwazaari gauss gun when its fire mode changes (KwazaariFireMode.cs). -->
	<JobDef>
		<defName>BOR_SwitchKwazaariFireMode</defName>
		<driverClass>BeyondOurReach.JobDriver_SwitchKwazaariFireMode</driverClass>
		<reportString>reprogramming kwazaari bolts.</reportString>
		<casualInterruptible>false</casualInterruptible>
		<suspendable>false</suspendable>
	</JobDef>
	<!-- ==================== Gen2 Kwazaari Gauss "Kwazeer" ammo: one cartridge per caliber ==================== -->
	<CombatExtended.AmmoCategoryDef>
		<defName>BOR_KwazeerStd_AmmoClass</defName>
		<label>kwazaari bolt</label>
		<labelShort>Bolt</labelShort>
		<description>A kwazaari alloy bolt with a programmable core. It hits no harder than a solar round, but it goes through armor two tiers above its own. The weapon sets the core before each shot: plain, explosive, EMP or incendiary.</description>
	</CombatExtended.AmmoCategoryDef>
	<!-- ==== kwazaari cartridges: 4mm (Pistol) ==== -->
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
		<defName>BOR_Ammo_4mmRailgun_KwazeerStd</defName>
		<label>4mm kwazaari cartridge</label>
		<description>A compact kwazaari alloy bolt round scaled for pistol-caliber railguns, with a core the weapon programs before each shot.</description>
		<statBases>
			<Mass>0.02</Mass>
			<Bulk>0.01</Bulk>
			<MarketValue>0.10</MarketValue>
		</statBases>
		<tradeTags Inherit="False">
			<li>CE_AmmoInjector</li>
			<li>CE_Ammo</li>
			<li>BOR_Tech_II</li>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_BOR_Bench_II</li>
			<li>CE_AutoEnableCrafting_BOR_Bench_IV</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo4mmRailgun</li>
		</thingCategories>
		<graphicData>
			<texPath>BOR/Things/Item/Equipment/weaponranged/gen1/mag/ammo/SS</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>BOR_KwazeerStd_AmmoClass</ammoClass>
		<generateAllowChance>0.10</generateAllowChance>
		<generateCommonality>0.01</generateCommonality>
	</ThingDef>
