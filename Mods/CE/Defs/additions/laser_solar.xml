	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>BOR_Gun_LaserRifle_TI</defName>
		<techLevel>Ultra</techLevel>
		<tradeTags>
			<li>BOR_Tech_I</li>
		</tradeTags>
		<label>solar less-lethal beam rifle</label>
		<description>A neutronium-infused beam rifle retuned for less-than-lethal crowd control. Its neutronium lens fires a neuralizer or EMP beam that drops a target without killing them.</description>
		<graphicData>
			<texPath>BOR/Things/Item/Equipment/weaponranged/gen1/laz0r/rifle-laser</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<thingCategories>
			<li>BOR_Weapons_I</li>
		</thingCategories>
		<statBases>
			<RoyalFavorValue>1.5</RoyalFavorValue>
			<WorkToMake>45000</WorkToMake>
			<Mass>3.85</Mass>
			<Bulk>11.00</Bulk>
			<SwayFactor>1.49</SwayFactor>
			<ShotSpread>0.09</ShotSpread>
			<SightsEfficiency>0.92</SightsEfficiency>
			<RangedWeapon_Cooldown>0.33</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>SpacerGun</li>
			<li>Laser</li>
			<li>CE_AI_AR</li>
