	<CombatExtended.AmmoCategoryDef>
		<defName>BOR_XCOM_Laser_Solar</defName>
		<label>solar neuralizer</label>
		<labelShort>neuralizer</labelShort>
		<description>A sunsteel-focused beam tuned to disrupt the nervous system. Repeated hits daze the target and then knock them out. It leaves only minor burns and ignores armor.</description>
	</CombatExtended.AmmoCategoryDef>
	<CombatExtended.AmmoCategoryDef>
		<defName>BOR_XCOM_LaserEMP_Neutronium</defName>
		<label>neutronium EMP</label>
		<labelShort>N-EM laser</labelShort>
		<description>An overcharged neutronium-driven electromagnetic beam. One hit breaks any shield belt and it disables machinery, but a load lasts only 5 shots. It barely hurts anyone behind armor.</description>
	</CombatExtended.AmmoCategoryDef>
