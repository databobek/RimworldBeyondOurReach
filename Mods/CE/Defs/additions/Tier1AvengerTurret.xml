<Defs>
	<!-- Solar defender ammo. BOR's Solar LMG rounds: FSJ is the sunsteel standard round and stops at the Solar marine (36),
	     QaP is the AP round and stops at the Ultra marine (46). Def names are the old 30mm PDC ones so existing stacks survive. -->
	<CombatExtended.AmmoSetDef>
		<defName>BOR_AmmoSet_PDC</defName>
		<label>9.5x60mm Solar PDC</label>
		<ammoTypes>
			<BOR_Ammo_PDC_FSJ>BOR_Bullet_PDC_FSJ</BOR_Ammo_PDC_FSJ>
			<BOR_Ammo_PDC_QaP>BOR_Bullet_PDC_QaP</BOR_Ammo_PDC_QaP>
			<BOR_Ammo_PDC_Ni>BOR_Bullet_PDC_Ni</BOR_Ammo_PDC_Ni>
			<BOR_Ammo_PDC_Ion>BOR_Bullet_PDC_Ion</BOR_Ammo_PDC_Ion>
