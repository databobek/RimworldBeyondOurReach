	<ThingDef Class="CombatExtended.AmmoDef" Name="BOR_PDCAmmoBase" ParentName="SpacerMediumAmmoBase" Abstract="True">
		<description>A sunsteel point-defense round for the solar defender turret.</description>
		<statBases>
			<Mass>0.05</Mass>
			<Bulk>0.06</Bulk>
		</statBases>
		<tradeTags>
			<li>BOR_Tech_I</li>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_BOR_Bench_I</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoAdvanced</li>
		</thingCategories>
		<stackLimit>5000</stackLimit>
	</ThingDef>

