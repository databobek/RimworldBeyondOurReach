<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Under Combat Extended the tenebral guns need ammo, so the Dark Archotech Altar makes it too, right after the guns.
	     The sniper rifle shares the rifle's rounds. -->
	<Operation Class="PatchOperationInsert">
		<xpath>/Defs/ThingDef[defName="BOR_DarkArchotechAltar_III"]/comps/li[@Class="BeyondOurReach.CompProperties_DarkAltar"]/entries/li[thing="BOR_Gun_LMG_TIII"]</xpath>
		<order>Append</order>
		<value>
			<li><thing>BOR_Ammo_Gen3Pistol_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Pistol_AP_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Pistol_Ion_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Shotgun_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Shotgun_Slug</thing></li>
			<li><thing>BOR_Ammo_Gen3Shotgun_Ion_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Rifle_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Rifle_AP_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Rifle_Ion_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Heavy_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Heavy_AP_N</thing></li>
			<li><thing>BOR_Ammo_Gen3Heavy_Ion_N</thing></li>
		</value>
	</Operation>
</Patch>
