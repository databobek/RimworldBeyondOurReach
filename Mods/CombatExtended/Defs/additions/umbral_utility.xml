<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Umbral utility pod projectiles. The pod weapons take no ammo, so these are fired directly, not from an ammo set. -->
	<ThingDef ParentName="BaseBulletCE">
		<defName>BOR_Bullet_UmbralPod_CE</defName>
		<label>umbral crystal sliver</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>TenebralBullet</damageDef>
			<damageAmountBase>45</damageAmountBase>
			<armorPenetrationSharp>180</armorPenetrationSharp>
			<armorPenetrationBlunt>400</armorPenetrationBlunt>
			<speed>180</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseBulletCE">
		<defName>BOR_Bullet_UmbralLauncher_CE</defName>
		<label>umbral vaporizing shard</label>
		<graphicData>
			<texPath>Things/Projectile/Rocket_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Vaporize</damageDef>
			<damageAmountBase>150</damageAmountBase>
			<explosionRadius>3</explosionRadius>
			<speed>60</speed>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
	</ThingDef>
</Defs>
