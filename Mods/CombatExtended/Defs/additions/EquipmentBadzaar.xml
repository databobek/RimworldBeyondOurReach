<Defs>
	<!-- Badzaari Heavy Armor (CE) -->
	<ThingDef ParentName="ArmorMachineableBase">
		<defName>BOR_Badzaari_Apparel_HeavyArmor</defName>
		<label>badzaari plate harness</label>
		<description>A bulky, hastily assembled powered armor shell hammered from Kwazaari alloys. It is brutally heavy, simple to build, and highly protective, but slows the wearer to a crawl.</description>
		<techLevel>Ultra</techLevel>
		<recipeMaker>
			<researchPrerequisites>
				<li>BOR_Research_Armor_II</li>
			</researchPrerequisites>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<skillRequirements>
				<Crafting>10</Crafting>
			</skillRequirements>
			<displayPriority>111</displayPriority>
			<recipeUsers Inherit="False">
				<li>BOR_Bench_II</li>
			</recipeUsers>
		</recipeMaker>
		<graphicData>
			<texPath>BOR/Things/Pawn/Humanlike/Apparel/Tier2BadzaarArmor/Tier2BadzaarArmor</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<WorkToMake>90000</WorkToMake>
			<MaxHitPoints>760</MaxHitPoints>
			<Mass>30</Mass>
			<Flammability>0.18</Flammability>
			<ArmorRating_Sharp>27.0</ArmorRating_Sharp>
			<ArmorRating_Blunt>13.2</ArmorRating_Blunt>
			<ArmorRating_Heat>14.16</ArmorRating_Heat>
			<Insulation_Cold>68</Insulation_Cold>
			<Insulation_Heat>20</Insulation_Heat>
			<EquipDelay>9</EquipDelay>
			<RoyalFavorValue>3</RoyalFavorValue>
			<Bulk>96</Bulk>
			<WornBulk>14</WornBulk>
		</statBases>
		<equippedStatOffsets>
			<ToxicEnvironmentResistance>0.85</ToxicEnvironmentResistance>
			<MoveSpeed>-3.0</MoveSpeed>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.40</VacuumResistance>
		</equippedStatOffsets>
		<thingCategories>
			<li>BOR_Armor_II</li>
		</thingCategories>
		<tradeTags>
			<li>HiTechArmor</li>
			<li>BOR_HiTechArmor_II</li>
			<li>BOR_Armor_II</li>
			<li>BOR_Tech_II</li>
		</tradeTags>
		<costList>
			<BOR_QuasarAlloy>190</BOR_QuasarAlloy>
			<BOR_QuasarAlloyWeave>80</BOR_QuasarAlloyWeave>
			<BOR_ComponentII>2</BOR_ComponentII>
		</costList>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Hands</li>
				<li>Feet</li>
			</bodyPartGroups>
			<useWornGraphicMask>true</useWornGraphicMask>
			<wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/Tier2BadzaarArmor/Tier2BadzaarArmor</wornGraphicPath>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<tags>
