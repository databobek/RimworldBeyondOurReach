                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
                <li>Hands</li>
                <li>Feet</li>
            </bodyPartGroups>
            <useWornGraphicMask>true</useWornGraphicMask>
            <wornGraphicPath>BOR/Things/Pawn/Humanlike/Apparel/SolarMarine/solar_marine</wornGraphicPath>
            <layers>
                <li>Middle</li>
                <li>Shell</li>
            </layers>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <useDeflectMetalEffect>true</useDeflectMetalEffect>
            <tags>
                <li>HiTechArmor</li>
                <li>BOR_Military_I</li>
            </tags>
        </apparel>
        <comps>
            <li Class="CompProperties_Biocodable" />
        </comps>
        <thingSetMakerTags>
            <li>RewardStandardHighFreq</li>
        </thingSetMakerTags>
