<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla XCOM Plasma Weapons</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!-- AmmoSet_XCOM_Gun_BeamRifle -->
				<!-- AmmoSet_XCOM_Gun_BeamSniperRifle -->
				<!-- AmmoSet_XCOM_Gun_BeamShotgun -->
				<!-- AmmoSet_XCOM_Gun_BeamPistol -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_XCOM_Gun_BeamRifle"]/ammoTypes</xpath>
					<value>
						<BOR_Ammo_XCOM_PlasmaCellRifleQuasarAlloy>BOR_XCOM_Bullet_BeamRifleQuasarAlloy</BOR_Ammo_XCOM_PlasmaCellRifleQuasarAlloy>
						<BOR_Ammo_XCOM_PlasmaCellRifleSunsteel>BOR_XCOM_Bullet_BeamRifleSunsteel</BOR_Ammo_XCOM_PlasmaCellRifleSunsteel>
						<BOR_Ammo_XCOM_PlasmaCellRifleTenebrite>BOR_XCOM_Bullet_BeamRifleTenebrite</BOR_Ammo_XCOM_PlasmaCellRifleTenebrite>
						<BOR_Ammo_XCOM_PlasmaCellRifleNeutronium>BOR_XCOM_Bullet_BeamRifleNeutronium</BOR_Ammo_XCOM_PlasmaCellRifleNeutronium>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_XCOM_Gun_BeamPistol"]/ammoTypes</xpath>
					<value>
						<BOR_Ammo_XCOM_PlasmaCellPistolQuasarAlloy>BOR_XCOM_Bullet_Beam_PistolQuasarAlloy</BOR_Ammo_XCOM_PlasmaCellPistolQuasarAlloy>
						<BOR_Ammo_XCOM_PlasmaCellPistolSunsteel>BOR_XCOM_Bullet_Beam_PistolSunsteel</BOR_Ammo_XCOM_PlasmaCellPistolSunsteel>
						<BOR_Ammo_XCOM_PlasmaCellPistolTenebrite>BOR_XCOM_Bullet_Beam_PistolTenebrite</BOR_Ammo_XCOM_PlasmaCellPistolTenebrite>
						<BOR_Ammo_XCOM_PlasmaCellPistolNeutronium>BOR_XCOM_Bullet_Beam_PistolNeutronium</BOR_Ammo_XCOM_PlasmaCellPistolNeutronium>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_XCOM_Gun_BeamSniperRifle"]/ammoTypes</xpath>
					<value>
						<BOR_Ammo_XCOM_PlasmaCellHeavyQuasarAlloy>BOR_XCOM_Bullet_BeamSniperRifleQuasarAlloy</BOR_Ammo_XCOM_PlasmaCellHeavyQuasarAlloy>
						<BOR_Ammo_XCOM_PlasmaCellHeavySunsteel>BOR_XCOM_Bullet_BeamSniperRifleSunsteel</BOR_Ammo_XCOM_PlasmaCellHeavySunsteel>
						<BOR_Ammo_XCOM_PlasmaCellHeavyTenebrite>BOR_XCOM_Bullet_BeamSniperRifleTenebrite</BOR_Ammo_XCOM_PlasmaCellHeavyTenebrite>
						<BOR_Ammo_XCOM_PlasmaCellHeavyNeutronium>BOR_XCOM_Bullet_BeamSniperRifleNeutronium</BOR_Ammo_XCOM_PlasmaCellHeavyNeutronium>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_XCOM_Gun_BeamShotgun"]/ammoTypes</xpath>
					<value>
						<BOR_Ammo_XCOM_PlasmaCellHeavyQuasarAlloy>BOR_XCOM_Bullet_BeamShotgunQuasarAlloy</BOR_Ammo_XCOM_PlasmaCellHeavyQuasarAlloy>
						<BOR_Ammo_XCOM_PlasmaCellHeavySunsteel>BOR_XCOM_Bullet_BeamShotgunSunsteel</BOR_Ammo_XCOM_PlasmaCellHeavySunsteel>
						<BOR_Ammo_XCOM_PlasmaCellHeavyTenebrite>BOR_XCOM_Bullet_BeamShotgunTenebrite</BOR_Ammo_XCOM_PlasmaCellHeavyTenebrite>
						<BOR_Ammo_XCOM_PlasmaCellHeavyNeutronium>BOR_XCOM_Bullet_BeamShotgunNeutronium</BOR_Ammo_XCOM_PlasmaCellHeavyNeutronium>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>