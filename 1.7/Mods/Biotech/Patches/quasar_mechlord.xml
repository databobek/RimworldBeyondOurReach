<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Combat Extended</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<!-- Mech Lord Helmet  -->
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarArmorHelmetMechlordHelmet"]/statBases/MaxHitPoints</xpath>
							<value>
								<MaxHitPoints>325</MaxHitPoints>
								<Mass>1.75</Mass>
								<ArmorRating_Sharp>19</ArmorRating_Sharp>
								<ArmorRating_Blunt>30</ArmorRating_Blunt>
								<Flammability>0.2</Flammability>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarArmorHelmetMechlordHelmet"]/equippedStatOffsets/ShootingAccuracyPawn</xpath>
							<value>
								<ToxicEnvironmentResistance>0.66</ToxicEnvironmentResistance>
								<SmokeSensitivity>-1</SmokeSensitivity>
								<AimingAccuracy>-0.25</AimingAccuracy>
								<ShootingAccuracyPawn>-0.85</ShootingAccuracyPawn>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarArmorHelmetMechlordHelmet"]/costList/BOR_QuasarAlloy</xpath>
							<value>
								<BOR_QuasarAlloy>165</BOR_QuasarAlloy>
							</value>
						</li>
						<li Class="PatchOperationAddModExtension">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarArmorHelmetMechlordHelmet"]</xpath>
							<value>
								<li Class="CombatExtended.ApparelDefExtension">
									<isRadioPack>true</isRadioPack>
								</li>
							</value>
						</li>
						<li Class="PatchOperationAdd">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarMechlordSuit"]/statBases</xpath>
							<value>
								<Bulk>75</Bulk>
								<WornBulk>15</WornBulk>
								<Mass>35</Mass>
								<MaxHitPoints>475</MaxHitPoints>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarMechlordSuit"]/statBases/ArmorRating_Sharp</xpath>
							<value>
								<ArmorRating_Sharp>18</ArmorRating_Sharp>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarMechlordSuit"]/statBases/ArmorRating_Blunt</xpath>
							<value>
								<ArmorRating_Blunt>25</ArmorRating_Blunt>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarMechlordSuit"]/costList/BOR_QuasarAlloy</xpath>
							<value>
								<BOR_QuasarAlloy>190</BOR_QuasarAlloy>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarMechlordSuit"]/equippedStatOffsets/ShootingAccuracyPawn</xpath>
							<value>
								<CarryWeight>60</CarryWeight>
								<CarryBulk>12</CarryBulk>
								<AimingAccuracy>-0.25</AimingAccuracy>
								<ShootingAccuracyPawn>-0.85</ShootingAccuracyPawn>
							</value>
						</li>
						<li Class="PatchOperationAdd">
							<xpath>Defs/ThingDef[defName="BOR_Apparel_QuasarMechlordSuit"]</xpath>
							<value>
								<modExtensions Inherit="False">
									<li Class="CombatExtended.PartialArmorExt">
										<stats>
											<li>
												<ArmorRating_Sharp>0.60</ArmorRating_Sharp>
												<parts>
													<li>Neck</li>
													<li>Hand</li>
												</parts>
											</li>
											<li>
												<ArmorRating_Blunt>0.60</ArmorRating_Blunt>
												<parts>
													<li>Neck</li>
													<li>Hand</li>
												</parts>
											</li>
											<li>
												<ArmorRating_Sharp>1.0</ArmorRating_Sharp>
												<parts>
													<li>Leg</li>
												</parts>
											</li>
											<li>
												<ArmorRating_Blunt>1.0</ArmorRating_Blunt>
												<parts>
													<li>Leg</li>
												</parts>
											</li>
											<li>
												<ArmorRating_Sharp>1.0</ArmorRating_Sharp>
												<parts>
													<li>Arm</li>
												</parts>
											</li>
											<li>
												<ArmorRating_Blunt>1.0</ArmorRating_Blunt>
												<parts>
													<li>Arm</li>
												</parts>
											</li>
										</stats>
									</li>
								</modExtensions>
							</value>
						</li>
					</operations>
				</match>
			</li>
		</operations>
	</Operation>
</Patch>